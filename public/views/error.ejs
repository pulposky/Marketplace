<!DOCTYPE html>
<html lang="es">
<head>
    <%# El error puede ocurrir antes de generar el token CSRF: se pasa vacío en ese caso %>
    <%- include('partials/headMeta', { titulo: 'Error ' + codigo, csrfToken: typeof csrfToken !== 'undefined' ? csrfToken : '' }) %>
    <%- include('partials/estilosTienda') %>
</head>
<body class="pagina-error">
    <main class="error">
        <p class="error-codigo"><%= codigo %></p>
        <h1><%= codigo === 404 ? 'Este pasillo no existe' : 'Algo salió mal' %></h1>
        <p><%= mensaje %></p>
        <div class="error-acciones">
            <a href="/catalogo" class="btn">Ir al catálogo</a>
            <a href="/" class="btn btn-suave">Inicio</a>
        </div>
    </main>
</body>
</html>
