<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/headMeta', { titulo: 'Mi perfil' }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <%- include('partials/estilosTienda') %>
</head>

<body>
    <%- include('partials/encabezado') %>

    <main class="contenedor contenedor-angosto">
        <%- include('partials/volver', { destino: '/' }) %>
        <header class="pagina-cabeza perfil-cabeza">
            <span class="perfil-inicial" aria-hidden="true"><%= (cliente.nombre || 'C').trim().charAt(0).toUpperCase() %></span>
            <div>
                <h1><%= cliente.nombre %></h1>
                <p>Documento <%= cliente.documento %></p>
            </div>
        </header>

        <div class="perfil-grid">
            <section class="panel" aria-labelledby="tituloEditar">
                <h2 id="tituloEditar">Tus datos</h2>
                <p class="panel-ayuda">Para guardar cambios escribe tu contraseña actual.</p>

                <form id="formPerfil" class="formulario formulario-dos" autocomplete="off">
                    <div class="campo campo-ancho">
                        <label for="perfilNombre">Nombre completo</label>
                        <input type="text" id="perfilNombre" name="nombre" value="<%= cliente.nombre %>" required maxlength="255">
                        <small>Es la dirección a la que enviamos tus pedidos.</small>
                    </div>
                    <div class="campo">
                        <label for="perfilTelefono">Teléfono</label>
                        <input type="tel" id="perfilTelefono" name="telefono" value="<%= cliente.telefono || '' %>" required maxlength="50">
                    </div>
                    <div class="campo">
                        <label for="perfilDireccion">Dirección <span class="opcional">(opcional)</span></label>
                        <input type="text" id="perfilDireccion" name="direccion" value="<%= cliente.direccion || '' %>" maxlength="255">
                    </div>

                    <fieldset class="campo-ancho grupo">
                        <legend>Cambiar contraseña <span class="opcional">(opcional)</span></legend>
                        <div class="formulario-dos">
                            <div class="campo">
                                <label for="perfilNuevaPassword">Nueva contraseña</label>
                                <input type="password" id="perfilNuevaPassword" name="nuevaPassword" placeholder="Mínimo 6 caracteres" maxlength="100" autocomplete="new-password">
                            </div>
                            <div class="campo">
                                <label for="perfilConfirmarPassword">Repite la nueva</label>
                                <input type="password" id="perfilConfirmarPassword" maxlength="100" autocomplete="new-password">
                            </div>
                        </div>
                    </fieldset>

                    <div class="campo campo-ancho">
                        <label for="perfilPassword">Contraseña actual</label>
                        <input type="password" id="perfilPassword" name="password" required autocomplete="current-password">
                    </div>
                    <button type="submit" class="btn campo-ancho" id="btnGuardarPerfil">Guardar cambios</button>
                </form>
            </section>

            <aside class="panel panel-suave" aria-labelledby="tituloRecoger">
                <h2 id="tituloRecoger">Entrega</h2>
                <dl class="ficha-datos">
                    <div><dt>La tienda</dt><dd><%= tienda.direccion || 'El punto de venta' %></dd></div>
                    <% if (tienda.horario) { %><div><dt>Horario</dt><dd><%= tienda.horario %></dd></div><% } %>
                    <% if (tienda.minutos_expiracion_apartado > 0) { %><div><dt>Te lo guardamos</dt><dd><%- include('partials/duracionApartado') %></dd></div><% } %>
                </dl>
                <a href="/verApartados" class="btn btn-suave btn-ancho">Ver mis pedidos</a>
            </aside>
        </div>
    </main>

    <%- include('partials/pie') %>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/perfil.js"></script>
</body>

</html>
