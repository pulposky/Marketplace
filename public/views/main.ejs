<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>SENAEMPRESA Marketplace</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/registro.css">
    <link rel="stylesheet" href="/css/toast.css">
</head>

<body>

    <!-- NAVBAR SUPERIOR -->
    <header class="navbar-superior">
        <!-- Contenedor Izquierdo -->
        <div class="navbar-izquierda">
            <img src="/img/Logo_SENAEMPRESA.png" alt="Logo SENAEMPRESA" class="imagen">
        </div>

        <!-- Contenedor Centro -->
        <div class="marca-navbar">
            <h2>SENAEMPRESA</h2>
        </div>

        <!-- Contenedor Derecho -->
        <div class="navbar-derecha">
            <% if (usuario) { %>
                <nav class="navegacion-navbar">
                    <ul class="lista-menu">
                        <% const rolNav=String(usuario.role || '' ).trim().toLowerCase(); %>
                            <% if (rolNav !=='admin' && rolNav !=='aprendiz' ) { %>
                                <li class="item-menu requiere-login">
                                    <a href="/perfil" class="btn-perfil-nav">Mi Perfil</a>
                                </li>
                                <% } %>
                                    <li class="item-menu requiere-login">
                                        <a href="/logout" class="btn-cerrar">Cerrar Sesión</a>
                                    </li>
                    </ul>
                </nav>
                <% } %>

                    <div class="acciones-navbar">
                        <% if (!usuario) { %>
                            <button type="button" class="btn-iniciar-sesion" id="abrirModalLogin">
                                Iniciar sesión
                            </button>
                            <% } %>
                    </div>
        </div>
    </header>

    <div class="contenedor-panel">

        <!-- CONTENIDO PRINCIPAL -->
        <div class="contenido-principal">

            <!-- CARRUSEL DE IMÁGENES -->
            <div class="carrusel" id="carrusel">
                <div class="carrusel-contenedor" id="carruselContenedor">
                </div>
            </div>

            <!-- BANNER BIENVENIDA -->
            <div class="banner-bienvenida">
                <% if (typeof usuario !=='undefined' && usuario) { %>
                    <h2>Bienvenido <%= usuario.nombre %>
                    </h2>
                    <% } else { %>
                        <h2>Bienvenido</h2>
                        <% } %>
                            <p>Encuentra los mejores productos en SENAEMPRESA.</p>
            </div>

            <!-- TARJETAS DE ESTADÍSTICAS -->
            <div class="cuadricula-estadisticas">
                <a class="enlace-estadistica navegacion" href="/catalogo">
                    <div class="tarjeta-estadistica">
                        <div class="detalles-estadistica">
                            <span class="titulo-estadistica">Productos disponibles</span>
                            <h3 class="valor-estadistica"></h3>
                            Explorar productos
                            <svg class="icono-estadistica" viewBox="0 0 48 48" fill="none"
                                xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <rect x="2" y="2" width="44" height="44" rx="12" fill="#39A900" />
                                <path d="M14 17l10-5 10 5-10 5-10-5z" fill="#fff" />
                                <path d="M14 24l10 5 10-5M14 31l10 5 10-5" stroke="#fff" stroke-width="2.5"
                                    stroke-linecap="round" stroke-linejoin="round" />
                            </svg>
                        </div>
                    </div>
                </a>
                <% if (usuario) { %>
                    <a class="enlace-estadistica navegacion" href="/verApartados">
                        <div class="tarjeta-estadistica">
                            <div class="detalles-estadistica requiere-login">
                                <span class="titulo-estadistica">Apartados activos</span>
                                <h3 class="valor-estadistica"></h3>
                                Ver mis apartados
                                <svg class="icono-estadistica" viewBox="0 0 48 48" fill="none"
                                    xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                    <rect x="2" y="2" width="44" height="44" rx="12" fill="#00A1DE" />
                                    <path d="M17 13h14a2 2 0 0 1 2 2v20l-9-5-9 5V15a2 2 0 0 1 2-2z" fill="#fff" />
                                </svg>
                            </div>
                        </div>
                    </a>
                    <% } %>
                        <a class="enlace-estadistica navegacion <%= (Array.isArray(ofertas) && ofertas.length> 0) ? 'con-ofertas' : 'desactivado' %>"
                            href="<%= (Array.isArray(ofertas) && ofertas.length> 0) ? '/catalogo' : '#' %>">
                            <div class="tarjeta-estadistica">
                                <div class="detalles-estadistica requiere-login">
                                    <span class="titulo-estadistica">Ofertas activas</span>
                                    <h3 class="valor-estadistica"></h3>
                                    <%= (Array.isArray(ofertas) && ofertas.length> 0) ? 'Ver ofertas' : 'No hay ofertas' %>
                                    <svg class="icono-estadistica" viewBox="0 0 48 48" fill="none"
                                        xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                        <rect x="2" y="2" width="44" height="44" rx="12" fill="#8E44AD" />
                                        <g transform="translate(12 12)">
                                            <path
                                                d="M21.41 11.58l-9-9C12.05 2.22 11.55 2 11 2H4c-1.1 0-2 .9-2 2v7c0 .55.22 1.05.59 1.42l9 9c.36.36.86.58 1.41.58.55 0 1.05-.22 1.41-.59l7-7c.37-.36.59-.86.59-1.41 0-.55-.23-1.06-.59-1.42zM5.5 7C4.67 7 4 6.33 4 5.5S4.67 4 5.5 4 7 4.67 7 5.5 6.33 7 5.5 7z"
                                                fill="#fff" />
                                        </g>
                                    </svg>
                                </div>
                            </div>
                        </a>
            </div>

            <!-- SECCIÓN PRODUCTOS DESTACADOS -->
            <div class="seccion-productos">
                <div class="encabezado-seccion">
                    <h3>Más Vendidos</h3>
                </div>
                <div class="cuadricula-productos">
                    <% destacados.forEach(producto=> {
                        // Detectamos si es un producto de huevos por bandera o por nombre
                        const esHuevo = producto.es_huevo || (producto.nombre &&
                        producto.nombre.toLowerCase().includes('huevo'));

                        // Reemplazamos 'UND' por 'CUBETA' en el nombre si aplica
                        const nombreMostrar = esHuevo ? producto.nombre.replace(/UND/gi, "CUBETA") : producto.nombre;
                        const unidadMostrar = esHuevo ? "Cubeta(s)" : (producto.unidad || "Unidad(es)");

                        // Precios (con oferta si aplica)
                        const precioUnitarioReal = Number(producto.precio);

                        // Oferta: descuento porcentual vigente por fechas
                        const descuentoProd = Number(producto.descuento) || 0;
                        const ahoraOferta = new Date();
                        const enOferta = descuentoProd > 0
                            && (!producto.fecha_inicio_oferta || ahoraOferta >= new Date(producto.fecha_inicio_oferta))
                            && (!producto.fecha_fin_oferta || ahoraOferta <= new Date(producto.fecha_fin_oferta));
                        const precioUnitarioOferta = enOferta
                            ? precioUnitarioReal * (1 - descuentoProd / 100)
                            : precioUnitarioReal;

                        // Precio que se muestra (por cubeta si es huevo, sino por unidad)
                        const precioCalculado = esHuevo ? precioUnitarioOferta * 30 : precioUnitarioOferta;
                        const precioOriginalCalculado = esHuevo ? precioUnitarioReal * 30 : precioUnitarioReal;

                        // Límite de stock
                        const limiteStockRaw = producto.limite_venta !== undefined && producto.limite_venta !== null ?
                        producto.limite_venta : 0;
                        const stockDisponible = esHuevo ? Math.floor(limiteStockRaw / 30) : limiteStockRaw;
                        %>
                        <div class="tarjeta-producto">
                            <a class="enlace-detalle-producto" href="/producto/<%= producto.id_producto %>"
                                title="Ver detalles de <%= nombreMostrar %>">
                                <div class="imagen-producto">
                                    <% if (producto.imagenUpload) { %>
                                        <img src="<%= producto.imagenUpload %>" alt="Imagen de <%= nombreMostrar %>">
                                        <% } else { %>
                                            <span class="imagen-placeholder">
                                                <%= nombreMostrar %>
                                            </span>
                                            <% } %>
                                </div>
                            </a>

                            <div class="info-producto">
                                <a class="enlace-detalle-producto" href="/producto/<%= producto.id_producto %>"
                                    title="Ver detalles de <%= nombreMostrar %>">
                                    <h4>
                                        <%= nombreMostrar %>
                                    </h4>
                                </a>

                                <p class="unidad">
                                    Presentación: <strong>
                                        <%= unidadMostrar %>
                                    </strong>
                                </p>

                                <% if (producto.descripcion) { %>
                                    <p class="descripcion-tarjeta">
                                        <%= producto.descripcion %>
                                    </p>
                                    <% } %>

                                <!-- Muestra del stock/disponibilidad -->
                                <p class="stock-producto">
                                    <span class="chip-stock">
                                        Disponibles: <strong>
                                            <%= stockDisponible %>
                                        </strong>
                                        <%= unidadMostrar %>
                                    </span>
                                </p>

                                <!-- Muestra del precio con desglose -->
                                <p class="precio-seccion">
                                    <% if (enOferta) { %>
                                        <span class="precio-original">
                                            $<%= precioOriginalCalculado.toLocaleString("es-CO") %>
                                        </span>
                                        <span class="precio-oferta">
                                            $<%= precioCalculado.toLocaleString("es-CO") %>
                                        </span>
                                        <span class="badge-oferta">
                                            -<%= descuentoProd %>% OFERTA
                                        </span>
                                    <% } else { %>
                                        <span class="precio">
                                            $<%= precioCalculado.toLocaleString("es-CO") %>
                                        </span>
                                    <% } %>
                                </p>

                                <button class="boton-apartar btn-accion-apartar" data-id="<%= producto.id_producto %>"
                                    data-nombre="<%= nombreMostrar %>"
                                    data-precio="$<%= precioCalculado.toLocaleString('es-CO') %>"
                                    data-imagen="<%= producto.imagenUpload || '' %>"
                                    data-descripcion="<%= (producto.descripcion || '').replace(/"/g, '&quot;') %>"
                                    data-es-huevo="<%= esHuevo ? 'true' : 'false' %>"
                                    data-limite="<%= stockDisponible %>">
                                    <%= usuario ? 'Apartar' : 'Ver' %>
                                </button>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
        </div>

        <!-- SECCIÓN CÓMO FUNCIONA / PROCESO DE COMPRA -->
        <section class="seccion-proceso">
            <div class="encabezado-seccion">
                <h3>¿Cómo funciona?</h3>
            </div>
            <div class="cuadricula-proceso">
                <div class="tarjeta-proceso">
                    <div class="numero-proceso">1</div>
                    <h4>Elige tus productos</h4>
                    <p>Explora el catálogo, busca por categoría y selecciona lo que necesites.</p>
                </div>
                <div class="tarjeta-proceso">
                    <div class="numero-proceso">2</div>
                    <h4>Aparta en línea</h4>
                    <p>Reserva tus productos online con tu cuenta. Se guardan para ti durante 1 hora.</p>
                </div>
                <div class="tarjeta-proceso">
                    <div class="numero-proceso">3</div>
                    <h4>Paga en el punto de venta</h4>
                    <p>Dirígete al Centro Agroindustrial Hachón y paga en el punto de venta físico.</p>
                </div>
                <div class="tarjeta-proceso">
                    <div class="numero-proceso">4</div>
                    <h4>Recoge tus productos</h4>
                    <p>Presenta tu apartado y retira lo que reservaste en el horario indicado.</p>
                </div>
            </div>
        </section>

        <!-- MODAL APARTAR PRODUCTO -->
        <div class="modal-fondo" id="modalApartarProducto">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModalProducto">&times;</span>

                <main class="card-container">
                    <div class="card-body">
                        <div class="modal-imagen" style="margin-bottom:12px;">
                            <img id="apartarImagenProducto" src="" alt="Imagen del producto"
                                style="width:100%; height:auto; display:block; object-fit:contain; border-radius:8px;" />
                        </div>
                        <h1 class="product-title" id="apartarNombreProducto">Nombre del Producto</h1>

                        <p class="descripcion-modal" id="apartarDescripcionProducto"
                            style="font-size: 0.9rem; color: #555; line-height: 1.45; margin: 8px 0 4px; display: none;"></p>

                        <div class="product-info">
                            <span class="price-tag" id="apartarPrecioProducto">$0 COP</span>
                        </div>

                        <form id="formConfirmarApartado" style="width: 100%; margin-top: 15px;">
                            <input type="hidden" id="apartarProductoId" name="productoId">

                            <div class="campo" style="margin-bottom: 12px;">
                                <label for="cantidadApartar" style="display:block; margin-bottom:5px;">Cantidad:</label>
                                <input type="number" id="cantidadApartar" name="cantidad" value="1" min="1" required
                                    style="width: 100%; padding: 8px;">
                            </div>

                            <button type="submit" class="btn-principal" style="width: 100%;">Apartar</button>
                        </form>
                    </div>
                </main>
            </div>
        </div>

        <!-- MODAL LOGIN -->
        <div class="modal-fondo" id="modalLogin">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModal">&times;</span>
                <div class="contenedor-login">
                    <div class="marca">
                        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
                        <span class="marca-texto">Marketplace</span>
                    </div>
                    <main class="login" role="main">
                        <div class="login-encabezado">
                            <h1>Bienvenido</h1>
                            <p>Ingresa tus credenciales para continuar</p>
                        </div>
                        <form class="login-form" id="formLogin">
                            <div class="campo campo-tipo" style="margin-bottom:8px;">
                                <div class="tipo-options">
                                    <label class="tipo-option">
                                        <input type="radio" id="tipo_cliente" name="tipoLogin" value="cliente" checked>
                                        <span class="tipo-label">Soy Cliente</span>
                                    </label>
                                    <label class="tipo-option">
                                        <input type="radio" id="tipo_usuario" name="tipoLogin" value="usuario">
                                        <span class="tipo-label">Soy Admin</span>
                                    </label>
                                </div>
                            </div>

                            <div id="clienteFields">
                                <div class="campo" id="campoDoc">
                                    <label for="doc">Documento</label>
                                    <input type="text" id="doc" name="documento" placeholder="Documento">
                                </div>
                                <div class="campo" id="campoPwd" style="display:none;">
                                    <label for="pwdCliente">Contraseña</label>
                                    <input type="password" id="pwdCliente" name="password" placeholder="Contraseña">
                                </div>
                                <div class="campo" id="campoNuevaPwd" style="display:none;">
                                    <label for="nuevaPwd">Nueva contraseña</label>
                                    <input type="password" id="nuevaPwd" name="nuevaPassword"
                                        placeholder="Crea tu contraseña">
                                </div>
                                <div class="campo" id="campoConfirmPwd" style="display:none;">
                                    <label for="confirmPwd">Confirmar contraseña</label>
                                    <input type="password" id="confirmPwd" placeholder="Repite tu contraseña">
                                </div>
                            </div>

                            <div id="usuarioFields" style="display:none;">
                                <div class="campo">
                                    <label for="user">Usuario</label>
                                    <input type="text" id="user" name="usuario" placeholder="Usuario">
                                </div>
                                <div class="campo">
                                    <label for="pwd">Contraseña</label>
                                    <input type="password" id="pwd" name="password" placeholder="Contraseña">
                                </div>
                            </div>

                            <button type="submit" id="btnLoginSubmit" class="btn-principal">Iniciar sesión</button>
                        </form>
                        <p class="login-pie">
                            ¿No tienes cuenta? <a href="#" class="enlace-fuerte enlace-registro">Regístrate</a>
                        </p>
                        <p class="login-pie" id="enlaceOlvideLogin" style="display:none;">
                            ¿Olvidaste tu contraseña? <a href="#" class="enlace-fuerte enlace-olvide">Recupérala</a>
                        </p>
                        <p id="mensaje" class="mensaje-error"></p>
                    </main>
                    <footer class="pie-pagina">
                        <span class="pie-punto" aria-hidden="true"></span>
                        SENA · Colombia
                    </footer>
                </div>
            </div>
        </div>

        <!-- MODAL REGISTRO -->
        <div class="modal-fondo" id="modalRegistro">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModalRegistro">&times;</span>
                <div class="contenedor-registro">
                    <div class="marca">
                        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
                        <span class="marca-texto">Marketplace</span>
                    </div>
                    <main class="registro" role="main">
                        <div class="registro-encabezado">
                            <h1>Crear Cuenta</h1>
                            <p>Completa tus datos para registrarte</p>
                        </div>
                        <form class="registro-form" id="formRegistro">
                            <div class="campo">
                                <label for="regNombre">Nombre completo</label>
                                <input type="text" id="regNombre" name="nombre" placeholder="Nombre completo">
                            </div>
                            <div class="campo">
                                <label for="regDocumento">Documento</label>
                                <input type="text" id="regDocumento" name="documento" placeholder="Número de documento">
                            </div>
                            <div class="campo">
                                <label for="regDireccion">Dirección</label>
                                <input type="text" id="regDireccion" name="direccion" placeholder="Dirección">
                            </div>
                            <div class="campo">
                                <label for="regTelefono">Teléfono</label>
                                <input type="text" id="regTelefono" name="telefono" placeholder="Teléfono">
                            </div>
                            <div class="campo">
                                <label for="regRol">Rol</label>
                                <select id="regRol" name="rol">
                                    <option value="" disabled selected>Selecciona un rol</option>
                                    <option value="aprendiz">Aprendiz</option>
                                    <option value="instructor">Instructor</option>
                                    <option value="contratista">Contratista</option>
                                    <option value="externo">Externo</option>
                                    <option value="administrativo">Administrativo</option>
                                </select>
                            </div>
                            <button type="submit" class="btn-principal">Registrarme</button>
                        </form>
                        <p class="registro-pie">
                            ¿Ya tienes cuenta? <a href="#" class="enlace-fuerte" id="volverLogin">Inicia sesión</a>
                        </p>
                        <p id="mensajeRegistro" class="mensaje-registro"></p>
                    </main>
                    <footer class="pie-pagina">
                        <span class="pie-punto" aria-hidden="true"></span>
                        SENA · Colombia
                    </footer>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER PRINCIPAL -->
    <footer class="pie-pagina-principal">
        <div class="contenedor-footer">

            <!-- Columna Izquierda: Información -->
            <div class="columna-footer columna-info">
                <h3>SENAEMPRESA</h3>
                <p class="descripcion-empresa">
                    Plataforma de comercio y gestión de productos para la comunidad SENA. Impulsando el desarrollo y
                    aprendizaje práctico.
                </p>
                <p class="ubicacion">📍 Centro Agroindustrial Hachón - Villavicencio, Meta</p>
            </div>

            <!-- Columna Central: Logo SENA Destacado -->
            <div class="columna-footer columna-centro">
                <a href="https://betowa.sena.edu.co/" target="_blank" rel="noopener noreferrer" class="enlace-logo-sena"
                    title="Visitar SENA">
                    <div class="contenedor-logo-sena">
                        <img src="/img/Logo_sena.png" alt="Logo SENA" class="logo-sena-footer">
                    </div>
                </a>
            </div>

            <!-- Columna Derecha: Redes Sociales -->
            <div class="columna-footer columna-redes">
                <h4>Síguenos</h4>
                <div class="redes-sociales">
                    <a href="https://www.facebook.com/people/Sena-Empresa-Cam-Hach%C3%B3n/61563872780107/?locale=es_LA"
                        target="_blank" aria-label="Facebook" class="icono-red facebook">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                            <path
                                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
                        </svg>
                    </a>
                    <a href="https://www.instagram.com/senaempresahachon/" target="_blank" aria-label="Instagram"
                        class="icono-red instagram">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                            <path
                                d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
