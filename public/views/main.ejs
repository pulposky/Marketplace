<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SENAEMPRESA Marketplace</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/login.css">
</head>

<body>

    <!-- NAVBAR SUPERIOR -->
    <header class="navbar-superior">
        <!-- Contenedor Izquierdo -->
        <div class="navbar-izquierda">
            <img src="/img/Logo_SENAEMPRESA.png" alt="Logo SENAEMPRESA" class="imagen">
        </div>

        <!-- Contenedor Centro -->
        <div class="marca-navbar">
            <h2>SENAEMPRESA</h2>
        </div>

        <!-- Contenedor Derecho -->
        <div class="navbar-derecha">
            <% if (usuario) { %>
                <nav class="navegacion-navbar">
                    <ul class="lista-menu">
                        <li class="item-menu requiere-login"><a href="#">Mis Datos</a></li>
                        <li class="item-menu requiere-login"><a href="#">Ayuda</a></li>
                        <li class="item-menu requiere-login">
                            <a href="/logout" class="btn-cerrar">Cerrar Sesión</a>
                        </li>
                    </ul>
                </nav>
                <% } %>

                    <div class="acciones-navbar">
                        <% if (!usuario) { %>
                            <button type="button" class="btn-iniciar-sesion" id="abrirModalLogin">
                                Iniciar sesión
                            </button>
                            <% } %>
                    </div>
        </div>
    </header>

    <div class="contenedor-panel">

        <!-- CONTENIDO PRINCIPAL -->
        <div class="contenido-principal">

            <!-- BANNER BIENVENIDA -->
            <div class="banner-bienvenida">
                <% if (typeof usuario !=='undefined' && usuario) { %>
                    <h2>Bienvenido <%= usuario.nombre %>
                    </h2>
                    <% } else { %>
                        <h2>Bienvenido</h2>
                        <% } %>
                            <p>Encuentra los mejores productos en SENAEMPRESA.</p>
            </div>

            <!-- TARJETAS DE ESTADÍSTICAS -->
            <div class="cuadricula-estadisticas">
                <a class="enlace-estadistica navegacion" href="/catalogo">
                    <div class="tarjeta-estadistica">
                        <div class="detalles-estadistica">
                            <span class="titulo-estadistica">Productos disponibles</span>
                            <h3 class="valor-estadistica"></h3>
                            Ver catálogo
                            <img class="catalogoimg" src="/img/catalogo.png" alt="">
                        </div>
                    </div>
                </a>
                <% if (usuario) { %>
                    <div class="tarjeta-estadistica">
                        <div class="detalles-estadistica requiere-login">
                            <span class="titulo-estadistica">Apartados activos</span>
                            <h3 class="valor-estadistica"></h3>
                            <a href="/verApartados" class="enlace-estadistica enlace-protegido">Ver mis apartados</a>
                        </div>
                    </div>
                    <% } %>
                        <div class="tarjeta-estadistica">
                            <div class="detalles-estadistica requiere-login">
                                <span class="titulo-estadistica">Ofertas activas</span>
                                <h3 class="valor-estadistica"></h3>
                                <a href="#" class="enlace-estadistica enlace-protegido">Ver ofertas</a>
                            </div>
                        </div>
            </div>

            <!-- SECCIÓN PRODUCTOS DESTACADOS -->
            <div class="seccion-productos">
                <div class="encabezado-seccion">
                    <h3>Productos Destacados</h3>
                </div>
                <div class="cuadricula-productos">
                    <% destacados.forEach(producto=> {
                        // Detectamos si es un producto de huevos por bandera o por nombre
                        const esHuevo = producto.es_huevo || (producto.nombre &&
                        producto.nombre.toLowerCase().includes('huevo'));

                        // Reemplazamos 'UND' por 'CUBETA' en el nombre si aplica
                        const nombreMostrar = esHuevo ? producto.nombre.replace(/UND/gi, "CUBETA") : producto.nombre;
                        const unidadMostrar = esHuevo ? "Cubeta(s)" : (producto.unidad || "Unidad(es)");

                        // Precios
                        const precioUnitarioReal = Number(producto.precio);
                        const precioCalculado = esHuevo ? precioUnitarioReal * 30 : precioUnitarioReal;

                        // Límite de stock
                        const limiteStockRaw = producto.limite_venta !== undefined && producto.limite_venta !== null ?
                        producto.limite_venta : 0;
                        const stockDisponible = esHuevo ? Math.floor(limiteStockRaw / 30) : limiteStockRaw;
                        %>
                        <div class="tarjeta-producto">
                            <div class="imagen-producto">
                                <% if (producto.imagenUpload) { %>
                                    <img src="<%= producto.imagenUpload %>" alt="Imagen de <%= nombreMostrar %>">
                                    <% } else { %>
                                        <span>
                                            <%= nombreMostrar %>
                                        </span>
                                        <% } %>
                            </div>

                            <div class="info-producto">
                                <h4>
                                    <%= nombreMostrar %>
                                </h4>

                                <p class="unidad" style="margin: 2px 0; color: #666;">
                                    Presentación: <strong>
                                        <%= unidadMostrar %>
                                    </strong>
                                </p>

                                <!-- Muestra del stock/disponibilidad -->
                                <p class="stock-producto" style="font-size: 0.85rem; color: #555; margin: 4px 0;">
                                    Disponibles: <strong>
                                        <%= stockDisponible %>
                                    </strong>
                                    <%= unidadMostrar %>
                                </p>

                                <!-- Muestra del precio con desglose -->
                                <p class="precio-seccion" style="margin: 6px 0;">
                                    <span class="precio"
                                        style="font-weight: bold; font-size: 1.1rem; color: #0d5c3a; display: block;">
                                        $<%= precioCalculado.toLocaleString("es-CO") %>
                                    </span>
                                </p>

                                <button class="boton-apartar btn-accion-apartar" data-id="<%= producto.id_producto %>"
                                    data-nombre="<%= nombreMostrar %>"
                                    data-precio="$<%= precioCalculado.toLocaleString('es-CO') %>"
                                    data-imagen="<%= producto.imagenUpload || '' %>"
                                    data-es-huevo="<%= esHuevo ? 'true' : 'false' %>"
                                    data-limite="<%= stockDisponible %>">
                                    <%= usuario ? 'Apartar' : 'Ver' %>
                                </button>
                            </div>
                        </div>
                        <% }) %>
                </div>
            </div>
        </div>

        <!-- MODAL APARTAR PRODUCTO -->
        <div class="modal-fondo" id="modalApartarProducto">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModalProducto">&times;</span>

                <main class="card-container">
                    <div class="card-body">
                        <div class="modal-imagen" style="margin-bottom:12px;">
                            <img id="apartarImagenProducto" src="" alt="Imagen del producto"
                                style="width:100%; height:auto; display:block; object-fit:contain; border-radius:8px;" />
                        </div>
                        <h1 class="product-title" id="apartarNombreProducto">Nombre del Producto</h1>

                        <div class="product-info">
                            <span class="price-tag" id="apartarPrecioProducto">$0 COP</span>
                        </div>

                        <form id="formConfirmarApartado" style="width: 100%; margin-top: 15px;">
                            <input type="hidden" id="apartarProductoId" name="productoId">

                            <div class="campo" style="margin-bottom: 12px;">
                                <label for="cantidadApartar" style="display:block; margin-bottom:5px;">Cantidad:</label>
                                <input type="number" id="cantidadApartar" name="cantidad" value="1" min="1" required
                                    style="width: 100%; padding: 8px;">
                            </div>

                            <button type="submit" class="btn-principal" style="width: 100%;">Apartar</button>
                        </form>
                    </div>
                </main>
            </div>
        </div>

        <!-- MODAL LOGIN -->
        <div class="modal-fondo" id="modalLogin">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModal">&times;</span>
                <div class="contenedor-login">
                    <div class="marca">
                        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
                        <span class="marca-texto">Marketplace</span>
                    </div>
                    <main class="login" role="main">
                        <div class="login-encabezado">
                            <h1>Bienvenido</h1>
                            <p>Ingresa tus credenciales para continuar</p>
                        </div>
                        <form class="login-form" id="formLogin">
                            <div class="campo campo-tipo" style="margin-bottom:8px;">
                                <div class="tipo-options">
                                    <label class="tipo-option">
                                        <input type="radio" id="tipo_cliente" name="tipoLogin" value="cliente" checked>
                                        <span class="tipo-label">Soy Cliente</span>
                                    </label>
                                    <label class="tipo-option">
                                        <input type="radio" id="tipo_usuario" name="tipoLogin" value="usuario">
                                        <span class="tipo-label">Soy Admin</span>
                                    </label>
                                </div>
                            </div>

                            <div id="clienteFields">
                                <div class="campo">
                                    <label for="doc">Documento</label>
                                    <input type="text" id="doc" name="documento" placeholder="Documento">
                                </div>
                            </div>

                            <div id="usuarioFields" style="display:none;">
                                <div class="campo">
                                    <label for="user">Usuario</label>
                                    <input type="text" id="user" name="usuario" placeholder="Usuario">
                                </div>
                                <div class="campo">
                                    <label for="pwd">Contraseña</label>
                                    <input type="password" id="pwd" name="password" placeholder="Contraseña">
                                </div>
                            </div>

                            <button type="submit" class="btn-principal">Iniciar sesión</button>
                        </form>
                        <p class="login-pie">
                            ¿No tienes cuenta? <a href="/registro" class="enlace-fuerte">Regístrate</a>
                        </p>
                        <p id="mensaje" class="mensaje-error"></p>
                    </main>
                    <footer class="pie-pagina">
                        <span class="pie-punto" aria-hidden="true"></span>
                        SENA · Colombia
                    </footer>
                </div>
            </div>
        </div>
    </div>

<!-- FOOTER PRINCIPAL -->
    <footer class="pie-pagina-principal">
        <div class="contenedor-footer">
            
            <!-- Columna Izquierda: Información -->
            <div class="columna-footer columna-info">
                <h3>SENAEMPRESA</h3>
                <p class="descripcion-empresa">
                    Plataforma de comercio y gestión de productos para la comunidad SENA. Impulsando el desarrollo y aprendizaje práctico.
                </p>
                <p class="ubicacion">📍 Centro Agroindustrial Hachón - Villavicencio, Meta</p>
            </div>

            <!-- Columna Central: Logo SENA Destacado -->
            <div class="columna-footer columna-centro">
                <a href="https://www.sena.edu.co" target="_blank" rel="noopener noreferrer" class="enlace-logo-sena" title="Visitar SENA">
                    <div class="contenedor-logo-sena">
                        <img src="/img/Logo_sena.png" alt="Logo SENA" class="logo-sena-footer">
                    </div>
                </a>
            </div>

            <!-- Columna Derecha: Redes Sociales -->
            <div class="columna-footer columna-redes">
                <h4>Síguenos</h4>
                <div class="redes-sociales">
                    <a href="https://facebook.com" target="_blank" aria-label="Facebook" class="icono-red facebook">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                    <a href="https://instagram.com" target="_blank" aria-label="Instagram" class="icono-red instagram">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                    </a>
                    <a href="https://tiktok.com" target="_blank" aria-label="TikTok" class="icono-red tiktok">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.28-2.36.54-4.74 2.19-6.42 1.43-1.47 3.42-2.31 5.48-2.35.45-.02.9.02 1.34.08v4.03c-.34-.07-.69-.11-1.04-.1-.85.01-1.69.32-2.33.88-.86.72-1.35 1.83-1.31 2.96.03.95.48 1.86 1.22 2.45.83.67 1.93.94 2.98.78 1.05-.14 2.01-.8 2.53-1.73.34-.58.53-1.25.53-1.93.02-3.88.01-7.77.01-11.66z"/></svg>
                    </a>
                </div>
            </div>

        </div>

        <div class="pie-copyright">
            <p>&copy; 2026 SENAEMPRESA Marketplace · Todos los derechos reservados.</p>
        </div>
    </footer>

    <!-- SCRIPTS CORTOS Y VINCULADOS -->
    <script src="/js/login.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>