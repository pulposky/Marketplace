<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/headMeta', { titulo: 'Inicio' }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <%- include('partials/estilosTienda') %>
</head>

<body>
    <%- include('partials/encabezado', { conModalLogin: !usuario }) %>
    <%- include('partials/pasillos', { pasillos }) %>

    <main class="contenedor">
        <section class="portada">
            <div>
                <% if (usuario) { %><p class="portada-saludo">Hola, <%= String(usuario.nombre || '').split(' ')[0] %></p><% } %>
                <h1><%= tienda.eslogan || 'Lo de todos los días, apartado en un minuto' %></h1>
            </div>
            <p>
                Te lo guardamos <%- include('partials/duracionApartado') %>.
                <% if (tienda.direccion) { %>Pagas y recoges en <%= tienda.direccion %>.<% } else { %>Pagas y recoges en la tienda.<% } %>
            </p>
        </section>

        <div class="carrusel" id="carrusel" aria-label="Avisos de la tienda">
            <div class="carrusel-contenedor" id="carruselContenedor"></div>
        </div>

        <section class="seccion seccion-productos" aria-labelledby="tituloDestacados">
            <div class="seccion-cabeza">
                <h2 id="tituloDestacados">Lo más apartado</h2>
                <div class="seccion-enlaces">
                    <% if (Array.isArray(ofertas) && ofertas.length) { %>
                        <a href="/catalogo?soloOferta=1"><%= ofertas.length %> en oferta</a>
                    <% } %>
                    <a href="/catalogo">Todo el catálogo</a>
                </div>
            </div>
            <div class="rejilla">
                <% destacados.forEach((producto) => { %>
                    <%- include('partials/tarjetaProducto', { producto, pasillos, modo: 'ver' }) %>
                <% }) %>
            </div>
        </section>

        <section class="seccion pasos" aria-labelledby="tituloPasos">
            <h2 id="tituloPasos">Cómo apartar</h2>
            <ol>
                <li><b>Elige</b><span>Busca o entra por pasillo y escoge la presentación: unidad, paca, cubeta…</span></li>
                <li><b>Aparta</b><span>Con tu cuenta lo reservas y te lo guardamos <%- include('partials/duracionApartado') %>.</span></li>
                <li><b>Paga en la tienda</b><span><% if (tienda.direccion) { %>En <%= tienda.direccion %>, al momento de recoger.<% } else { %>En el punto de venta, al momento de recoger.<% } %></span></li>
                <li><b>Recoge</b><span>Muestra tu apartado y llévate tus productos.</span></li>
            </ol>
        </section>
    </main>

    <%- include('partials/pie') %>
    <%- include('partials/modalesCuenta') %>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/login.js"></script>
    <script src="/js/registro.js"></script>
    <script src="/js/olvide.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>
