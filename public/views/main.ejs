<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SENAEMPRESA Marketplace</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/login.css">
</head>
<body>

    <div class="contenedor-panel">
        <!-- BARRA LATERAL -->
        <div class="barra-lateral">
            <div class="encabezado-lateral">
                <h2>SENAEMPRESA</h2>
                <p>Marketplace</p>
            </div>

            <% if (usuario) { %>
            <div class="navegacion-lateral">
                <div class="lista-menu">
                    <div class="item-menu activo requiere-login"><a href="#">Inicio</a></div>
                    <div class="item-menu requiere-login"><a href="#">Productos</a></div>
                    <div class="item-menu requiere-login"><a href="#">Mis Apartados</a></div>
                    <div class="item-menu requiere-login"><a href="#">Pedidos</a></div>
                    <div class="item-menu requiere-login"><a href="#">Mis Datos</a></div>
                    <div class="item-menu requiere-login"><a href="#">Ayuda</a></div>
                    <div class="item-menu requiere-login" data-pagina="logout">
                        <a>Cerrar Sesión</a>
                    </div>
                </div>
            </div>
            <% } %>
            </div>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="contenido-principal">
            
            <!-- ENCABEZADO / BUSCADOR -->
            <div class="encabezado-superior">
                <div class="barra-busqueda">
                    <input type="text" placeholder="Buscar productos...">
                </div>
                <div class="caja-carrito requiere-login">
                    <span>Carrito</span>
                </div>
            </div>

            <!-- BANNER BIENVENIDA -->
            <div class="banner-bienvenida">
                <h2>Bienvenido...</h2>
                <p>Encuentra los mejores productos para tu negocio.</p>
            </div>

            <!-- TARJETAS DE ESTADÍSTICAS -->
            <div class="cuadricula-estadisticas">
                <div class="tarjeta-estadistica">
                    <div class="detalles-estadistica">
                        <span class="titulo-estadistica">Productos disponibles</span>
                        <h3 class="valor-estadistica"><%= productos ? productos.length : 0 %></h3>
                        <div class="enlace-estadistica navegacion" data-pagina="catalogo">Ver catálogo</div>
                    </div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="detalles-estadistica requiere-login">
                        <span class="titulo-estadistica">Apartados activos</span>
                        <h3 class="valor-estadistica"></h3>
                        <a href="#" class="enlace-estadistica">Ver mis apartados</a>
                    </div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="detalles-estadistica requiere-login">
                        <span class="titulo-estadistica">Pedidos realizados</span>
                        <h3 class="valor-estadistica"></h3>
                        <a href="#" class="enlace-estadistica">Ver historial</a>
                    </div>
                </div>

                <div class="tarjeta-estadistica">
                    <div class="detalles-estadistica requiere-login">
                        <span class="titulo-estadistica">Ofertas activas</span>
                        <h3 class="valor-estadistica"></h3>
                        <a href="#" class="enlace-estadistica">Ver ofertas</a>
                    </div>
                </div>
            </div>

            <!-- SECCIÓN PRODUCTOS DESTACADOS -->
            <div class="seccion-productos">
                <div class="encabezado-seccion">
                    <h3>Productos Destacados</h3>
                </div>

                <div class="cuadricula-productos">
                    <% destacados.forEach(producto => { %>
                        <div class="tarjeta-producto">
                            <div class="info-producto">
                                <h4><%= producto.nombre %></h4>
                                <p class="unidad"><%= producto.unidad %></p>
                                <span class="precio">
                                    $<%= Number(producto.precio).toLocaleString("es-CO") %>
                                </span>
                                
                                <!-- BOTÓN DE APARTAR ACTUALIZADO CON SUS ATRIBUTOS -->
                                <div class="boton-apartar btn-accion-apartar" 
                                        data-id="<%= producto.id %>"
                                        data-nombre="<%= producto.nombre %>" 
                                        data-precio="$<%= Number(producto.precio).toLocaleString('es-CO') %>">
                                    Apartar
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>

        </div>

        <!-- MODAL APARTAR PRODUCTO (AGREGADO A TU VISTA MAIN) -->
        <div class="modal-fondo" id="modalApartarProducto">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModalProducto">&times;</span>

                <main class="card-container">
                    <div class="product-image-placeholder">
                        <span>Imagen del Producto</span>
                    </div>

                    <div class="card-body">
                        <h1 class="product-title" id="apartarNombreProducto">Nombre del Producto</h1>

                        <div class="product-info">
                            <span class="price-tag" id="apartarPrecioProducto">$0 COP</span>
                        </div>

                        <form id="formConfirmarApartado" style="width: 100%; margin-top: 15px;">
                            <input type="hidden" id="apartarProductoId" name="productoId">
                            
                            <div class="campo" style="margin-bottom: 12px;">
                                <label for="cantidadApartar" style="display:block; margin-bottom:5px;">Cantidad:</label>
                                <input type="number" id="cantidadApartar" name="cantidad" value="1" min="1" required style="width: 100%; padding: 8px;">
                            </div>

                            <button type="submit" class="btn-principal" style="width: 100%;">Confirmar Apartado</button>
                        </form>
                    </div>
                </main>
            </div>
        </div>

        <!-- MODAL LOGIN -->
        <div class="modal-fondo" id="modalLogin">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModal">&times;</span>
                <div class="contenedor-login">
                    <div class="marca">
                        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
                        <span class="marca-texto">Marketplace</span>
                    </div>
                    <main class="login" role="main">
                        <div class="login-encabezado">
                            <h1>Bienvenido</h1>
                            <p>Ingresa tus credenciales para continuar</p>
                        </div>
                        <form class="login-form" id="formLogin">
                            <div class="campo">
                                <label for="usuario">Usuario</label>
                                <input type="text" id="usuario" name="usuario" placeholder="Nombre de usuario" required>
                            </div>
                            <div class="campo">
                                <label for="password">Contraseña</label>
                                <input type="password" id="password" name="password" placeholder="Contraseña" required>
                            </div>
                            <button type="submit" class="btn-principal">Iniciar sesión</button>
                        </form>
                        <p class="login-pie">
                            ¿No tienes cuenta? <a href="/registro" class="enlace-fuerte">Regístrate</a>
                        </p>
                        <p id="mensaje" class="mensaje-error"></p>
                    </main>
                    <footer class="pie-pagina">
                        <span class="pie-punto" aria-hidden="true"></span>
                        SENA · Colombia
                    </footer>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS CORTOS Y VINCULADOS -->
    <script src="/js/login.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>