<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/headMeta', { titulo: 'Inicio' }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <%- include('partials/estilosTienda') %>
</head>

<body>
    <%- include('partials/encabezado', { conModalLogin: !usuario }) %>
    <%- include('partials/pasillos', { pasillos }) %>

    <main class="contenedor">
        <section class="portada">
            <div>
                <% if (usuario) { %><p class="portada-saludo">Hola, <%= String(usuario.nombre || '').split(' ')[0] %></p><% } %>
                <h1><%= tienda.eslogan || 'Lo de todos los días, apartado en un minuto' %></h1>
            </div>
            <a href="/catalogo" class="btn btn-grande">Ver el <%= vocab.catalogo.toLowerCase() %></a>
        </section>

        <%# Beneficios de apartar: lo que el cliente necesita saber antes de empezar %>
        <ul class="beneficios">
            <li><b>Te lo guardamos <%- include('partials/duracionApartado') %></b><span>Apartas en línea, sin filas</span></li>
            <li><b>Pagas al recoger</b><span><%= tienda.direccion || 'En el punto de venta' %></span></li>
            <% if (tienda.horario) { %><li><b>Horario</b><span><%= tienda.horario %></span></li><% } %>
            <% if (String(tienda.whatsapp || '').replace(/\D/g, '')) { %>
                <li><b>¿Dudas?</b><span><a href="https://wa.me/<%= String(tienda.whatsapp).replace(/\D/g, '') %>" target="_blank" rel="noopener noreferrer">Escríbenos por WhatsApp</a></span></li>
            <% } %>
        </ul>

        <div class="carrusel" id="carrusel" aria-label="Avisos de la tienda">
            <div class="carrusel-contenedor" id="carruselContenedor"></div>
        </div>

        <% if (vitrinaOfertas.length) { %>
        <section class="seccion vitrina-ofertas" aria-labelledby="tituloOfertas">
            <div class="seccion-cabeza">
                <h2 id="tituloOfertas">Ofertas de la semana</h2>
                <a class="seccion-ver" href="/catalogo?soloOferta=1">Ver las <%= ofertas.length %> ofertas</a>
            </div>
            <div class="rejilla">
                <% vitrinaOfertas.forEach((producto) => { %>
                    <%- include('partials/tarjetaProducto', { producto, pasillos, modo: 'ver' }) %>
                <% }) %>
            </div>
        </section>
        <% } %>

        <% if (destacados.length) { %>
        <section class="seccion seccion-productos" aria-labelledby="tituloDestacados">
            <div class="seccion-cabeza">
                <h2 id="tituloDestacados"><%= vocab.destacados %></h2>
                <a class="seccion-ver" href="/catalogo">Ver todo el <%= vocab.catalogo.toLowerCase() %></a>
            </div>
            <div class="rejilla">
                <% destacados.forEach((producto) => { %>
                    <%- include('partials/tarjetaProducto', { producto, pasillos, modo: 'ver' }) %>
                <% }) %>
            </div>
        </section>
        <% } %>

        <% secciones.forEach(({ pasillo, productos: lista }) => { %>
        <section class="seccion seccion-pasillo" style="--k:<%= pasillo.color %>" aria-labelledby="sec-<%= pasillo.numero %>">
            <div class="seccion-cabeza">
                <h2 id="sec-<%= pasillo.numero %>">
                    <% if (vocab.numerar) { %><small><%= vocab.seccion %> <%= pasillo.numero %></small><% } %>
                    <%= pasillo.nombre %>
                </h2>
                <a class="seccion-ver" href="/catalogo?categoria=<%= encodeURIComponent(pasillo.nombre) %>">Ver los <%= pasillo.total %></a>
            </div>
            <div class="rejilla">
                <% lista.forEach((producto) => { %>
                    <%- include('partials/tarjetaProducto', { producto, pasillos, modo: 'ver' }) %>
                <% }) %>
            </div>
        </section>
        <% }) %>

        <section class="seccion pasos" aria-labelledby="tituloPasos">
            <h2 id="tituloPasos">Cómo apartar</h2>
            <ol>
                <li><b>Elige</b><span>Busca o entra por <%= vocab.seccion.toLowerCase() %> y escoge la presentación: <%= vocab.ejemplosPresentacion %></span></li>
                <li><b>Aparta</b><span>Con tu cuenta lo reservas y te lo guardamos <%- include('partials/duracionApartado') %>.</span></li>
                <li><b>Paga en la tienda</b><span><% if (tienda.direccion) { %>En <%= tienda.direccion %>, al momento de recoger.<% } else { %>En el punto de venta, al momento de recoger.<% } %></span></li>
                <li><b>Recoge</b><span>Muestra tu apartado y llévate tus productos.</span></li>
            </ol>
        </section>
    </main>

    <%- include('partials/pie') %>
    <%- include('partials/modalesCuenta') %>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/login.js"></script>
    <script src="/js/registro.js"></script>
    <script src="/js/olvide.js"></script>
    <script src="/js/main.js"></script>
</body>

</html>
