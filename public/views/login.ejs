<div class="contenedor">
    <div class="marca">
        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
        <span class="marca-texto">Marketplace</span>
    </div>

    <main class="login" role="main">
        <div class="login-encabezado">
            <h1>Bienvenido</h1>
            <p>Ingresa tus credenciales para continuar</p>
        </div>

        <form class="login-form" id="formLogin">
            <div class="campo">
                <label for="usuario">Usuario</label>
                <input type="text" id="usuario" name="usuario" placeholder="Nombre de usuario" required>
            </div>

            <div class="campo">
                <label for="password">Contraseña</label>
                <input type="password" id="password" name="password" placeholder="Contraseña" required>
            </div>

            <button type="submit" class="btn-principal">Iniciar sesión</button>
        </form>

        <p class="login-pie">
            ¿No tienes cuenta? <a href="/registro" class="enlace-fuerte">Regístrate</a>
        </p>
        <p id="mensaje" class="mensaje-error"></p>
    </main>

    <footer class="pie-pagina">
        <span class="pie-punto" aria-hidden="true"></span>
        SENA · Colombia
    </footer>
</div>