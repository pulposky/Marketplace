<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/headMeta', { titulo: producto.nombre }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <%- include('partials/estilosTienda') %>
</head>

<body>
    <%
        // Misma lógica de precios que el catálogo; el stock está en la unidad mínima
        const unidad = nombreUnidad(producto.unidad);
        const presentaciones = Array.isArray(producto.presentaciones) ? producto.presentaciones : [];
        const pasillo = (pasillos || []).find((p) => p.nombre === String(producto.categoria || '').trim()) || null;

        const precioBase = Number(producto.precio) || 0;
        const descuento = Number(producto.descuento) || 0;
        const ahora = new Date();
        const enOferta = descuento > 0
            && (!producto.fecha_inicio_oferta || ahora >= new Date(producto.fecha_inicio_oferta))
            && (!producto.fecha_fin_oferta || ahora <= new Date(producto.fecha_fin_oferta));
        const precioUnidad = enOferta ? precioBase * (1 - descuento / 100) : precioBase;

        const principal = presentaciones[0] || null;
        const factor = principal ? Number(principal.factor) || 1 : 1;
        const etiqueta = principal ? principal.nombre : unidad;
        const stock = Number(producto.limite_venta) || 0;
        const cop = (n) => '$' + Math.round(n).toLocaleString('es-CO');
        const etiquetaPasillo = pasillo ? pasillo.nombre : '';
    %>
    <%- include('partials/encabezado') %>

    <main class="contenedor ficha"<%- pasillo ? ` style="--k:${pasillo.color}"` : '' %>>
        <%- include('partials/volver', { destino: '/catalogo' }) %>
        <nav class="migas" aria-label="Ruta">
            <a href="/catalogo"><%= vocab.catalogo %></a>
            <% if (pasillo) { %><span aria-hidden="true">/</span><a href="/catalogo?categoria=<%= encodeURIComponent(pasillo.nombre) %>"><%= etiquetaPasillo %></a><% } %>
        </nav>

        <div class="ficha-grid">
            <div class="ficha-foto">
                <% if (producto.imagenUpload) { %>
                    <img src="<%= producto.imagenUpload %>" alt="<%= producto.nombre %>">
                <% } else { %>
                    <span class="producto-sin-foto"><%= String(producto.nombre || '?').charAt(0) %></span>
                <% } %>
                <% if (enOferta) { %><i class="producto-oferta">−<%= Math.round(descuento) %>%</i><% } %>
            </div>

            <div class="ficha-info">
                <% if (pasillo) { %><p class="ficha-pasillo"><%= etiquetaPasillo %></p><% } %>
                <h1><%= producto.nombre %></h1>

                <p class="ficha-precio">
                    <% if (enOferta) { %><s><%= cop(precioBase * factor) %></s><% } %>
                    <b id="fichaPrecio"><%= cop(precioUnidad * factor) %></b>
                    <span id="fichaEtiqueta">/ <%= etiqueta %></span>
                </p>

                <% if (producto.descripcion) { %><p class="ficha-descripcion"><%= producto.descripcion %></p><% } %>

                <% if (!usuario) { %>
                    <% if (presentaciones.length) { %>
                        <p class="ficha-se-vende">Se vende por: <%= presentaciones.map((p) => `${p.nombre} (${p.factor} ${unidad})`).join(', ') %></p>
                    <% } %>
                    <a href="/catalogo?login=1&amp;desde=producto" class="btn btn-grande">Entra para hacer tu pedido</a>
                <% } else if (stock < factor) { %>
                    <p class="ficha-agotado">Agotado por ahora.</p>
                <% } else { %>
                    <div class="ficha-compra">
                        <% if (presentaciones.length) { %>
                            <fieldset class="segmentos">
                                <legend>Presentación</legend>
                                <div class="segmentos-fila">
                                    <% presentaciones.forEach((p, i) => { %>
                                        <label>
                                            <input type="radio" name="presentacionDetalle" value="<%= p.id %>"
                                                data-factor="<%= p.factor %>" data-nombre="<%= p.nombre %>" <%= i === 0 ? 'checked' : '' %>>
                                            <span><b><%= p.nombre %></b><small><%= p.factor %> <%= unidad %></small></span>
                                        </label>
                                    <% }) %>
                                </div>
                            </fieldset>
                        <% } %>

                        <%- include('partials/opcionesEntrega') %>
                        <div class="ficha-cantidad">
                            <div class="campo">
                                <label for="cantidadDetalle">Cantidad</label>
                                <input type="number" id="cantidadDetalle" value="1" min="1" max="<%= Math.floor(stock / factor) %>" required>
                            </div>
                            <button type="button" class="btn btn-grande" id="btnApartarDetalle"
                                data-id="<%= producto.id_producto %>"
                                data-precio-unitario="<%= precioUnidad %>"
                                data-unidad="<%= unidad %>"
                                data-limite="<%= stock %>">Pedir ahora</button>
                        </div>
                        <%# Solo avisa cuando quedan pocas (productoDetalle.js lo recalcula por presentación) %>
                        <p class="ficha-disponibles" id="textoDisponiblesDetalle" data-mostrar="<%= vocab.mostrarStock ? '1' : '' %>"<%- vocab.mostrarStock && Math.floor(stock / factor) <= 5 ? '' : ' hidden' %>>
                            ¡Quedan <span id="cantDisponiblesDetalle"><%= Math.floor(stock / factor) %></span>
                            <span id="unidadDisponiblesDetalle"><%= etiqueta %></span>!
                        </p>
                    </div>
                <% } %>

                <dl class="ficha-datos">
                    <% if (tienda.minutos_expiracion_apartado > 0) { %><div><dt>Te lo guardamos</dt><dd><%- include('partials/duracionApartado') %></dd></div><% } %>
                    <% if (tienda.entrega !== 'domicilio') { %><div><dt>Recoges en</dt><dd><%= tienda.direccion || 'El punto de venta' %></dd></div><% } %>
                    <div><dt>Pago</dt><dd>Al recibir tu pedido</dd></div>
                    <% if (tienda.horario) { %><div><dt>Horario</dt><dd><%= tienda.horario %></dd></div><% } %>
                </dl>
            </div>
        </div>
    </main>

    <%- include('partials/pie') %>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/productoDetalle.js"></script>
</body>

</html>
