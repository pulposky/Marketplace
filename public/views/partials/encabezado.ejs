<%# Barra superior de la tienda pública.
    Opcionales: buscadorId (id del campo de búsqueda; el catálogo usa 'inputBuscar' para filtrar en vivo),
    busqueda (texto ya buscado) y conModalLogin (true si la página trae el modal de login). %>
<%
    const _usuario = typeof usuario !== 'undefined' ? usuario : null;
    const _buscadorId = (typeof buscadorId !== 'undefined' && buscadorId) ? buscadorId : 'buscarProductos';
    const _busqueda = typeof busqueda !== 'undefined' ? busqueda : '';
    const _conModal = typeof conModalLogin !== 'undefined' && conModalLogin;
%>
<% if (tienda.apariencia.anuncio_activo && tienda.apariencia.anuncio) { %>
<div class="anuncio"><%= tienda.apariencia.anuncio %></div>
<% } %>
<header class="barra">
    <div class="barra-interior">
        <a href="/" class="barra-marca">
            <img src="<%= tienda.logo_url || '/img/marca/logo-default.svg' %>" alt="" class="barra-logo">
            <span><%= tienda.nombre %></span>
        </a>

        <form class="barra-buscar" action="/catalogo" method="get" role="search">
            <label for="<%= _buscadorId %>" class="solo-lector">Buscar productos</label>
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input type="search" id="<%= _buscadorId %>" name="busqueda" value="<%= _busqueda %>" placeholder="<%= vocab.buscar %>" autocomplete="off">
        </form>

        <nav class="barra-nav" aria-label="Tu cuenta">
            <% if (!(_usuario && esRolPanel(_usuario.role))) { %>
                <a href="/carrito" class="barra-carrito" aria-label="Carrito">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20.5" r="1.2"/><circle cx="18" cy="20.5" r="1.2"/></svg>
                    <span>Carrito</span>
                    <b class="barra-carrito-contador" data-contador-carrito hidden>0</b>
                </a>
            <% } %>
            <% if (_usuario && esRolPanel(_usuario.role)) { %>
                <a href="/admin">Panel</a>
            <% } else if (_usuario) { %>
                <a href="/verApartados">Mis pedidos</a>
                <a href="/perfil">Perfil</a>
            <% } %>
            <% if (_usuario) { %>
                <form method="POST" action="/logout" class="barra-salir">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Salir</button>
                </form>
            <% } else if (_conModal) { %>
                <button type="button" class="btn btn-chico" id="abrirModalLogin">Entrar</button>
            <% } else { %>
                <a href="/catalogo?login=1" class="btn btn-chico">Entrar</a>
            <% } %>
        </nav>
    </div>

    <%
        // Menú principal: puntos clave de la tienda. Las categorías salen de "pasillos" cuando la página los trae.
        const _cats = (typeof pasillos !== 'undefined' && Array.isArray(pasillos)) ? pasillos : [];
        const _ofertas = typeof soloOferta !== 'undefined' && soloOferta;
        const _actual = rutaActual === '/' ? 'inicio'
            : (rutaActual === '/catalogo' || rutaActual.startsWith('/producto')) ? (_ofertas ? 'ofertas' : 'categorias') : '';
        const _hayPasos = (tienda.bloques_inicio || []).some((b) => b.tipo === 'pasos');
        const _marca = (clave) => _actual === clave ? ' aria-current="page"' : '';
    %>
    <nav class="menu" aria-label="Principal">
        <ul class="menu-interior">
            <li><a href="/"<%- _marca('inicio') %>>Inicio</a></li>
            <li>
                <% if (_cats.length) { %>
                <details class="menu-desplegable">
                    <summary<%- _actual === 'categorias' ? ' class="actual"' : '' %>><%= vocab.secciones %></summary>
                    <ul>
                        <% _cats.forEach((c) => { %>
                            <li><a href="/catalogo?categoria=<%= encodeURIComponent(c.nombre) %>" style="--k:<%= c.color %>"><%= c.nombre %> <small><%= c.total %></small></a></li>
                        <% }) %>
                        <li><a href="/catalogo" class="menu-todas">Ver todo el <%= vocab.catalogo.toLowerCase() %></a></li>
                    </ul>
                </details>
                <% } else { %>
                <a href="/catalogo"<%- _actual === 'categorias' ? ' aria-current="page"' : '' %>><%= vocab.secciones %></a>
                <% } %>
            </li>
            <li><a href="/catalogo?soloOferta=1"<%- _marca('ofertas') %>>Ofertas</a></li>
            <% if (_hayPasos) { %><li><a href="/#como-comprar">Cómo comprar</a></li><% } %>
            <li><a href="#contacto">Contacto</a></li>
        </ul>
    </nav>
</header>
