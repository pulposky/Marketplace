<!-- Aviso compartido para clientes que solicitan recuperar su contraseña. -->
<div class="modal-fondo" id="modalOlvide">
    <div class="modal-contenido modal-cuenta" role="dialog" aria-modal="true" aria-labelledby="tituloOlvide">
        <button type="button" class="cerrar-modal" id="cerrarModalOlvide" aria-label="Cerrar">&times;</button>
        <p class="modal-marca"><%= tienda.nombre %></p>
        <h2 id="tituloOlvide">Recuperar contraseña</h2>
        <p class="modal-ayuda">La tienda te da una clave temporal. Llama o escribe a este número con tu documento a la mano; después de entrar, cámbiala desde tu perfil.</p>
        <p id="contactoRecuperacion" class="contacto-recuperacion" aria-live="polite">Cargando número de contacto…</p>
        <p class="modal-pie"><a href="#" id="volverLoginOlvide">Volver a entrar</a></p>
    </div>
</div>
