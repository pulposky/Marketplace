<%# Pie de la tienda pública: franja de beneficios (solo lo que la tienda realmente ofrece según su
    configuración), navegación y los datos de contacto que el dueño haya llenado. %>
<%
    const _wa = String(tienda.whatsapp || '').replace(/\D/g, '');
    const _usuarioPie = typeof usuario !== 'undefined' ? usuario : null;
    const _cats = (typeof pasillos !== 'undefined' && Array.isArray(pasillos)) ? pasillos.slice(0, 6) : [];
    const _hayContacto = tienda.direccion || tienda.horario || tienda.telefono || _wa || tienda.correo;
    const _hayPasosPie = (tienda.bloques_inicio || []).some((b) => b.tipo === 'pasos');

    // Iconos de trazo (24x24). Las marcas de redes van rellenas.
    const _trazos = {
        camion: '<path d="M3 6h11v10H3zM14 9h4l3 3v4h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/>',
        tienda: '<path d="M4 10v10h16V10M3 10l2-6h14l2 6M3 10h18M9 20v-6h6v6"/>',
        chat: '<path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12Z"/><path d="M8.5 12h.01M12 12h.01M15.5 12h.01"/>',
        reloj: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
        ubicacion: '<path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/>',
        telefono: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z"/>',
        correo: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
        flecha: '<path d="m9 6 6 6-6 6"/>',
        arriba: '<path d="M12 19V5M5 12l7-7 7 7"/>',
        mapa: '<path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2ZM9 4v14M15 6v14"/>'
    };
    const _ico = (n) => '<svg class="pie-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + _trazos[n] + '</svg>';
    const _marcas = {
        Facebook: '<path d="M14 8.5V6.8c0-.8.5-1 1-1h2V2.5h-2.8C11.1 2.5 10 4.4 10 6.7v1.8H7.5V12H10v9.5h4V12h2.8l.5-3.5H14Z"/>',
        Instagram: '<path d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4ZM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM12 2c-2.7 0-3 0-4.1.1C4.3 2.2 2.2 4.3 2.1 7.9 2 9 2 9.3 2 12s0 3 .1 4.1c.1 3.6 2.2 5.7 5.8 5.8 1.1.1 1.4.1 4.1.1s3 0 4.1-.1c3.6-.1 5.7-2.2 5.8-5.8.1-1.1.1-1.4.1-4.1s0-3-.1-4.1c-.1-3.6-2.2-5.7-5.8-5.8C15 2 14.7 2 12 2Zm0 1.8c2.7 0 3 0 4 .1 2.6.1 3.9 1.4 4 4 .1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.6-1.4 3.9-4 4-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.6-.1-3.9-1.4-4-4-.1-1-.1-1.3-.1-4s0-3 .1-4c.1-2.6 1.4-3.9 4-4 1-.1 1.3-.1 4-.1Z"/>',
        TikTok: '<path d="M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .9.1V9.1a6.3 6.3 0 1 0 5.4 6.3V8.6a7.7 7.7 0 0 0 4.4 1.4V6.6a4.4 4.4 0 0 1-4.4-4.6Z"/>'
    };
    const _redes = [['Facebook', tienda.facebook], ['Instagram', tienda.instagram], ['TikTok', tienda.tiktok]].filter((r) => r[1]);

    const _beneficios = [];
    if (tienda.entrega !== 'recoger') _beneficios.push(['camion', 'Envío a domicilio', tienda.nota_entrega || 'Te lo llevamos a donde nos digas']);
    if (tienda.entrega !== 'domicilio') _beneficios.push(['tienda', 'Recoge en la tienda', tienda.direccion || 'Pasa por tu pedido cuando esté listo']);
    if (_wa) _beneficios.push(['chat', 'Pide por WhatsApp', 'Te asesoramos antes de comprar']);
    if (tienda.horario) _beneficios.push(['reloj', 'Horario de atención', tienda.horario]);
    const _mapa = tienda.direccion ? 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(tienda.direccion + ' ' + tienda.nombre) : '';
%>
<footer class="pie" id="contacto">
    <% if (_beneficios.length) { %>
    <div class="pie-beneficios-fondo">
        <ul class="pie-beneficios" aria-label="Por qué comprar aquí">
            <% _beneficios.forEach((b) => { %>
                <li><span class="pie-beneficio-ico"><%- _ico(b[0]) %></span><span><b><%= b[1] %></b><small><%= b[2] %></small></span></li>
            <% }) %>
        </ul>
    </div>
    <% } %>

    <div class="pie-interior">
        <div class="pie-marca">
            <a href="/" class="pie-nombre"><%= tienda.nombre %></a>
            <% if (tienda.eslogan || tienda.descripcion) { %><p><%= tienda.eslogan || tienda.descripcion %></p><% } %>
            <div class="pie-acciones">
                <% if (_wa) { %>
                    <a class="pie-whatsapp" href="https://wa.me/<%= _wa %>" target="_blank" rel="noopener noreferrer"><%- _ico('chat') %>Escríbenos</a>
                <% } %>
                <% if (_redes.length) { %>
                    <ul class="pie-redes" aria-label="Redes sociales">
                        <% _redes.forEach((r) => { %><li><a href="<%= r[1] %>" target="_blank" rel="noopener noreferrer" aria-label="<%= r[0] %>" title="<%= r[0] %>"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><%- _marcas[r[0]] %></svg></a></li><% }) %>
                    </ul>
                <% } %>
            </div>
        </div>

        <nav class="pie-col" aria-labelledby="pieTienda">
            <h2 id="pieTienda">Compra</h2>
            <ul class="pie-enlaces">
                <li><a href="/catalogo"><%- _ico('flecha') %>Todo el <%= vocab.catalogo.toLowerCase() %></a></li>
                <li><a href="/catalogo?soloOferta=1"><%- _ico('flecha') %>Ofertas</a></li>
                <% _cats.forEach((c) => { %><li><a href="/catalogo?categoria=<%= encodeURIComponent(c.nombre) %>"><%- _ico('flecha') %><%= c.nombre %></a></li><% }) %>
            </ul>
        </nav>

        <nav class="pie-col" aria-labelledby="pieCuenta">
            <h2 id="pieCuenta">Tu cuenta</h2>
            <ul class="pie-enlaces">
                <% if (!_usuarioPie) { %><li><a href="/catalogo?login=1"><%- _ico('flecha') %>Entrar o registrarme</a></li><% } %>
                <li><a href="/carrito"><%- _ico('flecha') %>Mi carrito</a></li>
                <li><a href="/verApartados"><%- _ico('flecha') %>Mis pedidos</a></li>
                <% if (_usuarioPie) { %><li><a href="/perfil"><%- _ico('flecha') %>Mi perfil</a></li><% } %>
                <% if (_hayPasosPie) { %><li><a href="/#como-comprar"><%- _ico('flecha') %>Cómo comprar</a></li><% } %>
            </ul>
        </nav>

        <% if (_hayContacto) { %>
        <div class="pie-col">
            <h2>Contacto</h2>
            <ul class="pie-contacto">
                <% if (tienda.direccion) { %><li><%- _ico('ubicacion') %><span><%= tienda.direccion %></span></li><% } %>
                <% if (tienda.horario) { %><li><%- _ico('reloj') %><span><%= tienda.horario %></span></li><% } %>
                <% if (tienda.telefono) { %><li><%- _ico('telefono') %><a href="tel:<%= String(tienda.telefono).replace(/[^\d+]/g, '') %>"><%= tienda.telefono %></a></li><% } %>
                <% if (tienda.correo) { %><li><%- _ico('correo') %><a href="mailto:<%= tienda.correo %>"><%= tienda.correo %></a></li><% } %>
            </ul>
            <% if (_mapa) { %><a class="pie-mapa" href="<%= _mapa %>" target="_blank" rel="noopener noreferrer"><%- _ico('mapa') %>Cómo llegar</a><% } %>
        </div>
        <% } %>
    </div>

    <div class="pie-base">
        <p>&copy; <%= new Date().getFullYear() %> <%= tienda.nombre %>. Todos los derechos reservados.</p>
        <a href="#" class="pie-arriba"><%- _ico('arriba') %>Volver arriba</a>
    </div>
</footer>
<% if (_wa) { %>
<a class="whatsapp-flotante" href="https://wa.me/<%= _wa %>?text=<%= encodeURIComponent('Hola, vengo de la tienda en línea de ' + tienda.nombre) %>"
    target="_blank" rel="noopener noreferrer" aria-label="Escríbenos por WhatsApp">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M16.04 3C9.4 3 4 8.33 4 14.9c0 2.33.69 4.5 1.88 6.34L4 29l7.99-1.83A12.2 12.2 0 0 0 16.04 26.8C22.67 26.8 28 21.47 28 14.9S22.67 3 16.04 3Zm0 21.6c-1.92 0-3.71-.52-5.24-1.43l-.38-.22-4.74 1.09 1.11-4.52-.25-.39a9.6 9.6 0 0 1-1.5-5.13c0-5.33 4.42-9.7 9.98-9.7 5.5 0 9.92 4.37 9.92 9.7 0 5.34-4.42 9.6-9.9 9.6Zm5.45-7.25c-.3-.15-1.77-.86-2.04-.96-.28-.1-.48-.15-.68.15-.2.29-.78.96-.96 1.15-.18.2-.35.22-.65.08-.3-.15-1.26-.46-2.4-1.46a8.9 8.9 0 0 1-1.66-2.04c-.17-.3-.02-.45.13-.6.14-.13.3-.34.45-.51.15-.18.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.6-.92-2.2-.24-.57-.49-.5-.67-.5h-.58c-.2 0-.52.07-.8.37-.27.29-1.04 1-1.04 2.45 0 1.44 1.07 2.84 1.21 3.03.15.2 2.1 3.17 5.08 4.44.71.3 1.27.49 1.7.62.71.23 1.36.2 1.88.12.57-.09 1.77-.71 2.02-1.4.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.34Z"/></svg>
    <span>WhatsApp</span>
</a>
<% } %>
<script src="/js/carrito.js"></script>
<script src="/js/tiendaAnimaciones.js" defer></script>
