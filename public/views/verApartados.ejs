<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('partials/headMeta', { titulo: 'Mis apartados' }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <%- include('partials/estilosTienda') %>
</head>

<body>
    <%- include('partials/encabezado') %>

    <%
        const lista = typeof apartados !== 'undefined' && Array.isArray(apartados) ? apartados : [];
        const estadoDe = (item) => item.estado_apartado || 'pendiente';
        // Activos: pendiente o confirmado. Historial: entregado o cancelado.
        const activos = lista.filter((item) => !['entregado', 'cancelado'].includes(estadoDe(item)));
        const historial = lista.filter((item) => ['entregado', 'cancelado'].includes(estadoDe(item)));
        const cop = (n) => '$' + Math.round(n).toLocaleString('es-CO');

        // La BD guarda unidades mínimas y el precio aplicado por unidad mínima.
        // Si el apartado guardó presentación, la cantidad se muestra en ella.
        const resumen = (item) => {
            const factor = Number(item.presentacion_factor) || 0;
            const conPres = !!item.presentacion_nombre && factor > 0;
            const unidad = item.unidad || 'unidad';
            const unidades = Number(item.cantidad) || 0;
            const precioUnidad = Number(item.precio_aplicado) > 0 ? Number(item.precio_aplicado) : Number(item.precio) || 0;
            return {
                cantidad: conPres ? Math.floor(unidades / factor) : unidades,
                nombreCantidad: conPres ? item.presentacion_nombre : unidad,
                detalle: conPres ? `${unidades} ${unidad} en total` : '',
                precioPorUno: conPres ? precioUnidad * factor : precioUnidad,
                antes: Number(item.precio_aplicado) > 0 && Number(item.precio_aplicado) < Number(item.precio)
                    ? (conPres ? Number(item.precio) * factor : Number(item.precio)) : 0,
                total: unidades * precioUnidad,
            };
        };
    %>

    <main class="contenedor contenedor-angosto">
        <header class="pagina-cabeza">
            <h1>Mis apartados</h1>
            <p>Lo que tienes guardado en la tienda y lo que ya recogiste.</p>
        </header>

        <% if (usuario) { %>
        <section class="notificaciones" id="seccionNotificaciones" style="display:none;" aria-labelledby="tituloNotif">
            <div class="notificaciones-cabeza">
                <h2 id="tituloNotif">Novedades</h2>
                <button type="button" class="btn-texto" id="btnMarcarTodasNotif">Marcar todo como leído</button>
            </div>
            <div class="notificaciones-lista" id="listaNotificaciones">
                <p class="notif-vacio">Cargando…</p>
            </div>
        </section>
        <% } %>

        <% if (!activos.length && !historial.length) { %>
            <div class="vacio vacio-grande">
                <h2>Aún no has apartado nada</h2>
                <p>Recorre el <%= vocab.catalogo.toLowerCase() %> y aparta lo que necesites; te lo guardamos <%- include('partials/duracionApartado') %>.</p>
                <a href="/catalogo" class="btn">Ir al <%= vocab.catalogo.toLowerCase() %></a>
            </div>
        <% } %>

        <% if (activos.length) { %>
        <section class="seccion" aria-labelledby="tituloActivos">
            <h2 id="tituloActivos" class="seccion-subtitulo">Por recoger</h2>
            <ul class="apartados">
                <% activos.forEach((item) => {
                    const r = resumen(item);
                    const estado = estadoDe(item);
                    const confirmado = estado === 'confirmado';
                %>
                <li class="apartado tarjeta-producto" id="apartado-<%= item.id_apartado %>" data-estado="<%= estado %>">
                    <div class="apartado-foto">
                        <% if (item.imagenUpload) { %><img src="<%= item.imagenUpload %>" alt=""><% } else { %><span class="producto-sin-foto"><%= String(item.nombre || '?').charAt(0) %></span><% } %>
                    </div>
                    <div class="apartado-info">
                        <p class="apartado-nombre"><%= item.nombre %></p>
                        <p class="apartado-cantidad">
                            <b><%= r.cantidad %></b> <%= r.nombreCantidad %> × <%= cop(r.precioPorUno) %>
                            <% if (r.antes) { %><s><%= cop(r.antes) %></s><% } %>
                            <% if (r.detalle) { %><small><%= r.detalle %></small><% } %>
                        </p>
                        <% if (!confirmado && item.fecha) {
                            const expira = new Date(new Date(item.fecha).getTime() + (Number(tienda.minutos_expiracion_apartado) || 60) * 60 * 1000);
                        %>
                            <p class="temporizador-apartado" data-expira="<%= expira.toISOString() %>">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                                <span class="texto-temporizador"></span>
                            </p>
                        <% } %>
                    </div>
                    <div class="apartado-lado">
                        <span class="estado estado-<%= estado %>"><%= confirmado ? 'Listo para recoger' : 'Pendiente' %></span>
                        <b class="apartado-total"><%= cop(r.total) %></b>
                        <% if (confirmado) { %>
                            <button type="button" class="btn-texto btn-dismiss" data-id="<%= item.id_apartado %>">Ocultar</button>
                        <% } else { %>
                            <button type="button" class="btn-texto btn-peligro btn-accion-cancelar" data-id="<%= item.id_apartado %>">Cancelar</button>
                        <% } %>
                    </div>
                </li>
                <% }) %>
            </ul>
        </section>
        <% } %>

        <% if (historial.length) { %>
        <section class="seccion" aria-labelledby="tituloHistorial">
            <div class="seccion-cabeza">
                <h2 id="tituloHistorial" class="seccion-subtitulo">Historial</h2>
                <div class="filtro-fechas">
                    <label>Desde <input type="date" id="filtro-desde"></label>
                    <label>Hasta <input type="date" id="filtro-hasta"></label>
                    <button type="button" class="btn-texto" id="btn-limpiar-filtro">Limpiar</button>
                </div>
            </div>
            <ul class="historial">
                <% historial.forEach((item) => {
                    const r = resumen(item);
                    const estado = estadoDe(item);
                    const fecha = item.fecha ? new Date(item.fecha) : null;
                    const fechaLocal = fecha ? `${fecha.getFullYear()}-${String(fecha.getMonth() + 1).padStart(2, '0')}-${String(fecha.getDate()).padStart(2, '0')}` : '';
                    const motivo = estado === 'cancelado' && item.cancelado_por
                        ? (item.cancelado_por === 'cliente' ? 'Lo cancelaste tú' : 'Lo canceló la tienda') : '';
                %>
                <li class="tarjeta-historial" data-fecha="<%= fechaLocal %>">
                    <span class="historial-fecha"><%= fecha ? fecha.toLocaleDateString('es-CO', { day: 'numeric', month: 'short', year: 'numeric' }) : '' %></span>
                    <span class="historial-nombre"><%= item.nombre %> <small><%= r.cantidad %> <%= r.nombreCantidad %><%= motivo ? ' · ' + motivo : '' %></small></span>
                    <span class="estado estado-<%= estado %>"><%= estado === 'entregado' ? 'Entregado' : 'Cancelado' %></span>
                    <b class="historial-total"><%= cop(r.total) %></b>
                </li>
                <% }) %>
            </ul>
            <p id="filtro-historial-vacio" class="vacio" style="display:none;">No hay pedidos entre esas fechas.</p>
        </section>
        <% } %>
    </main>

    <%- include('partials/pie') %>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/verApartados.js"></script>
</body>

</html>
