<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Apartados - SENAEMPRESA</title>
    <link rel="stylesheet" href="/css/verApartados.css">
    <link rel="stylesheet" href="/css/toast.css">
</head>

<body>

    <!-- HEADER Y BOTÓN REGRESAR -->
    <header class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <span>SENAEMPRESA</span>
            </div>
            <a href="/" class="btn-inicio">← Regresar al Inicio</a>
        </div>
    </header>

    <!-- CONTENEDOR PRINCIPAL -->
    <main class="contenedor-principal">
        <div class="encabezado-seccion">
            <div>
                <h1 class="titulo-catalogo">MIS APARTADOS</h1>
                <p class="subtitulo-seccion">Consulta y gestiona los productos que has reservado.</p>
            </div>
        </div>

        <% 
        // Apartados ACTIVOS: los que todavía se pueden gestionar (pendiente/confirmado)
        const apartadosVisibles = (typeof apartados !== 'undefined') 
            ? apartados.filter(item => {
                const estado = item.estado_apartado || 'pendiente';
                return estado !== 'entregado' && estado !== 'cancelado';
            }) 
            : [];

        // HISTORIAL: pedidos terminados (entregados o cancelados)
        const apartadosHistorial = (typeof apartados !== 'undefined') 
            ? apartados.filter(item => {
                const estado = item.estado_apartado || 'pendiente';
                return estado === 'entregado' || estado === 'cancelado';
            }) 
            : [];
        %>

        <% if (apartadosVisibles.length === 0 && apartadosHistorial.length === 0) { %>
            <div class="estado-vacio">
                <h3>No tienes apartados ni historial de compras</h3>
                <p>Explora nuestro catálogo y aparta tus productos favoritos.</p>
                <a href="/catalogo" class="btn-explorar">Ver Catálogo</a>
            </div>
        <% } else { %>
        <% if (apartadosVisibles.length > 0) { %>
            <div class="rejilla-productos">
                <% apartadosVisibles.forEach(item => {
                    // 1. Detectar si el ítem es huevo
                    const esHuevo = item.es_huevo || (item.nombre && item.nombre.toLowerCase().includes('huevo'));

                    // 2. Precio base: usamos el precio capturado al apartar (ya con descuento).
                    //    Si viene en 0 (apartados viejos sin precio), caemos al precio actual del producto.
                    const precioUnitarioReal = Number(item.precio_aplicado) > 0
                        ? Number(item.precio_aplicado)
                        : Number(item.precio);
                    const precioSinDescuento = Number(item.precio);
                    const precioCubeta = esHuevo ? precioUnitarioReal * 30 : precioUnitarioReal;
                    const precioCubetaSinDesc = esHuevo ? precioSinDescuento * 30 : precioSinDescuento;
                    const hayDescuento = Number(item.precio_aplicado) > 0
                        && Number(item.precio_aplicado) < Number(item.precio);

                    // 3. Convertir unidades guardadas en BD a cubetas si aplica
                    const cantidadHuevosUnidades = Number(item.cantidad);
                    const cubetas = esHuevo ? Math.floor(cantidadHuevosUnidades / 30) : cantidadHuevosUnidades;

                    // 4. Calcular el total acumulado real a pagar
                    const totalPagar = esHuevo ? cubetas * precioCubeta : cantidadHuevosUnidades * precioUnitarioReal;

                    // 5. Estado del apartado
                    const estadoApartado = item.estado_apartado || 'pendiente';
                    const esConfirmado = estadoApartado === 'confirmado';

                    // Texto legible del estado
                    const textoEstado = {
                        confirmado: 'Confirmado',
                        pendiente: 'Pendiente'
                    }[estadoApartado] || 'Pendiente';
                %>
                    <div class="tarjeta-producto" id="apartado-<%= item.id_apartado %>" data-estado="<%= estadoApartado %>">
                        <div class="imagen-producto">
                            <% if (item.imagenUpload) { %>
                                <img src="<%= item.imagenUpload %>" alt="Imagen de <%= item.nombre %>">
                            <% } else { %>
                                <span><%= item.nombre %></span>
                            <% } %>
                            <span class="badge-estado <%= estadoApartado %>">
                                <%= textoEstado %>
                            </span>
                        </div>

                        <div class="nombre-producto">
                            <%= item.nombre %>
                        </div>

                        <p class="presentacion-producto">
                            Cantidad: <strong><%= esHuevo ? cubetas : cantidadHuevosUnidades %></strong>
                            <%= esHuevo ? 'Cubeta(s)' : (item.unidad || 'Unidad(es)') %>
                            <% if (esHuevo) { %>
                                <small style="display: block; color: #666;">(<%= cantidadHuevosUnidades %> huevos en total)</small>
                            <% } %>
                        </p>

                        <p class="presentacion-producto">
                            <% if (esHuevo) { %>
                                Precio por cubeta: <strong>$<%= precioCubeta.toLocaleString("es-CO") %></strong>
                                <% if (hayDescuento) { %>
                                    <small style="display:block; color:#d32f2f;">
                                        Antes $<%= precioCubetaSinDesc.toLocaleString("es-CO") %>
                                    </small>
                                <% } %>
                                <small style="display: block; color: #888;">($<%= precioUnitarioReal.toLocaleString("es-CO") %> / huevo)</small>
                            <% } else { %>
                                Precio un.: $<%= precioUnitarioReal.toLocaleString("es-CO") %>
                                <% if (hayDescuento) { %>
                                    <small style="display:block; color:#d32f2f;">
                                        Antes $<%= precioSinDescuento.toLocaleString("es-CO") %>
                                    </small>
                                <% } %>
                            <% } %>
                        </p>

                        <div class="precio-producto">
                            Total: $<%= totalPagar.toLocaleString("es-CO") %>
                        </div>

                        <% if (!esConfirmado && item.fecha) { 
                            const fechaApartado = new Date(item.fecha);
                            const expira = new Date(fechaApartado.getTime() + 60 * 60 * 1000);
                        %>
                            <div class="temporizador-apartado" data-expira="<%= expira.toISOString() %>">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                </svg>
                                <span class="texto-temporizador"></span>
                            </div>
                        <% } %>

                        <% if (esConfirmado) { %>
                            <button type="button" class="btn-dismiss btn-dismiss-confirmado" data-id="<%= item.id_apartado %>">
                                Ocultar
                            </button>
                        <% } else { %>
                            <button type="button" class="btn-cancelar btn-accion-cancelar" data-id="<%= item.id_apartado %>">
                                Cancelar Apartado
                            </button>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } %>

        <% if (apartadosHistorial.length > 0) { %>
            <div class="seccion-historial">
                <h2 class="titulo-seccion-historial">HISTORIAL DE COMPRAS</h2>
                <p class="subtitulo-seccion">Pedidos entregados o cancelados.</p>

                <div class="filtro-historial">
                    <div class="filtro-cabecera">
                        <svg class="icono-filtro" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                            <line x1="16" y1="2" x2="16" y2="6"></line>
                            <line x1="8" y1="2" x2="8" y2="6"></line>
                            <line x1="3" y1="10" x2="21" y2="10"></line>
                        </svg>
                        <span>Filtrar por fecha</span>
                    </div>
                    <div class="filtro-campos">
                        <label class="filtro-campo">
                            <span class="filtro-etiqueta">Desde</span>
                            <input type="date" id="filtro-desde" aria-label="Fecha desde">
                        </label>
                        <label class="filtro-campo">
                            <span class="filtro-etiqueta">Hasta</span>
                            <input type="date" id="filtro-hasta" aria-label="Fecha hasta">
                        </label>
                        <button type="button" class="btn-limpiar-filtro" id="btn-limpiar-filtro">
                            <svg class="icono-limpiar" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <polyline points="1 4 1 10 7 10"></polyline>
                                <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                            </svg>
                            Limpiar filtro
                        </button>
                    </div>
                </div>

                <div class="rejilla-historial">
                    <% apartadosHistorial.forEach(item => {
                        // 1. Detectar si el ítem es huevo
                        const esHuevoH = item.es_huevo || (item.nombre && item.nombre.toLowerCase().includes('huevo'));

                        // 2. Precios base (capturado al apartar, con fallback al precio actual)
                        const precioUnitarioH = Number(item.precio_aplicado) > 0
                            ? Number(item.precio_aplicado)
                            : Number(item.precio);
                        const precioCubetaH = esHuevoH ? precioUnitarioH * 30 : precioUnitarioH;

                        // 3. Convertir unidades a cubetas si aplica
                        const cantidadUnidadesH = Number(item.cantidad);
                        const cubetasH = esHuevoH ? Math.floor(cantidadUnidadesH / 30) : cantidadUnidadesH;

                        // 4. Total pagado
                        const totalHistorial = esHuevoH ? cubetasH * precioCubetaH : cantidadUnidadesH * precioUnitarioH;

                        // 5. Estado del pedido
                        const estadoH = item.estado_apartado || 'cancelado';
                        const esCanceladoH = estadoH === 'cancelado';
                        const textoEstadoH = estadoH === 'entregado' ? 'Entregado' : 'Cancelado';
                        const fechaItemH = item.fecha ? new Date(item.fecha) : null;
                        const fechaTextoH = fechaItemH ? fechaItemH.toLocaleString('es-CO') : '';
                        // Fecha en formato yyyy-mm-dd para poder compararla con los inputs del filtro
                        const fechaLocal = fechaItemH
                            ? `${fechaItemH.getFullYear()}-${String(fechaItemH.getMonth() + 1).padStart(2, '0')}-${String(fechaItemH.getDate()).padStart(2, '0')}`
                            : '';
                        const motivoH = esCanceladoH && item.cancelado_por
                            ? (item.cancelado_por === 'cliente' ? 'Cancelado por el cliente' : 'Cancelado por el administrador')
                            : '';
                    %>
                        <div class="tarjeta-historial" data-fecha="<%= fechaLocal %>">
                            <div class="imagen-miniatura">
                                <% if (item.imagenUpload) { %>
                                    <img src="<%= item.imagenUpload %>" alt="Imagen de <%= item.nombre %>">
                                <% } else { %>
                                    <span><%= item.nombre %></span>
                                <% } %>
                            </div>
                            <div class="detalle-historial">
                                <div class="fila-historial">
                                    <span class="nombre-producto"><%= item.nombre %></span>
                                    <span class="badge-estado <%= estadoH %>"><%= textoEstadoH %></span>
                                </div>
                                <p class="presentacion-historial">
                                    Cantidad: <strong><%= esHuevoH ? cubetasH : cantidadUnidadesH %></strong>
                                    <%= esHuevoH ? 'Cubeta(s)' : (item.unidad || 'Unidad(es)') %>
                                </p>
                                <p class="presentacion-historial">
                                    Total: <strong>$<%= totalHistorial.toLocaleString('es-CO') %></strong>
                                </p>
                                <% if (fechaTextoH) { %>
                                    <p class="fecha-historial">Fecha: <%= fechaTextoH %></p>
                                <% } %>
                                <% if (motivoH) { %>
                                    <p class="nota-cancelado"><%= motivoH %></p>
                                <% } %>
                            </div>
                        </div>
                    <% }) %>
                </div>
                <p id="filtro-historial-vacio" class="filtro-historial-vacio" style="display:none;">
                    No hay pedidos en el rango de fechas seleccionado.
                </p>
            </div>
        <% } %>
        <% } %>
    </main>

    <script src="/js/toast.js"></script>
    <script src="/js/verApartados.js"></script>
</body>

</html>