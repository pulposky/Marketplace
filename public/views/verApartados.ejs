<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mis Apartados - SENAEMPRESA</title>
    <link rel="stylesheet" href="/css/verApartados.css">
    <link rel="stylesheet" href="/css/toast.css">
</head>

<body>

    <!-- HEADER Y BOTÓN REGRESAR -->
    <header class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <span>SENAEMPRESA</span>
            </div>
            <a href="/" class="btn-inicio">← Regresar al Inicio</a>
        </div>
    </header>

    <!-- CONTENEDOR PRINCIPAL -->
    <main class="contenedor-principal">
        <div class="encabezado-seccion">
            <div>
                <h1 class="titulo-catalogo">MIS APARTADOS</h1>
                <p class="subtitulo-seccion">Consulta y gestiona los productos que has reservado.</p>
            </div>
        </div>

        <% 
        // Filtrar para obtener solo los apartados que NO están entregados ni cancelados
        const apartadosVisibles = (typeof apartados !== 'undefined') 
            ? apartados.filter(item => {
                const estado = item.estado_apartado || 'pendiente';
                return estado !== 'entregado' && estado !== 'cancelado';
            }) 
            : [];
        %>

        <% if (apartadosVisibles.length > 0) { %>
            <div class="rejilla-productos">
                <% apartadosVisibles.forEach(item => {
                    // 1. Detectar si el ítem es huevo
                    const esHuevo = item.es_huevo || (item.nombre && item.nombre.toLowerCase().includes('huevo'));

                    // 2. Precios base
                    const precioUnitarioReal = Number(item.precio);
                    const precioCubeta = esHuevo ? precioUnitarioReal * 30 : precioUnitarioReal;

                    // 3. Convertir unidades guardadas en BD a cubetas si aplica
                    const cantidadHuevosUnidades = Number(item.cantidad);
                    const cubetas = esHuevo ? Math.floor(cantidadHuevosUnidades / 30) : cantidadHuevosUnidades;

                    // 4. Calcular el total acumulado real a pagar
                    const totalPagar = esHuevo ? cubetas * precioCubeta : cantidadHuevosUnidades * precioUnitarioReal;

                    // 5. Estado del apartado
                    const estadoApartado = item.estado_apartado || 'pendiente';
                    const esConfirmado = estadoApartado === 'confirmado';

                    // Texto legible del estado
                    const textoEstado = {
                        confirmado: 'Confirmado',
                        pendiente: 'Pendiente'
                    }[estadoApartado] || 'Pendiente';
                %>
                    <div class="tarjeta-producto" id="apartado-<%= item.id_apartado %>" data-estado="<%= estadoApartado %>">
                        <div class="imagen-producto">
                            <% if (item.imagenUpload) { %>
                                <img src="<%= item.imagenUpload %>" alt="Imagen de <%= item.nombre %>">
                            <% } else { %>
                                <span><%= item.nombre %></span>
                            <% } %>
                            <span class="badge-estado <%= estadoApartado %>">
                                <%= textoEstado %>
                            </span>
                        </div>

                        <div class="nombre-producto">
                            <%= item.nombre %>
                        </div>

                        <p class="presentacion-producto">
                            Cantidad: <strong><%= esHuevo ? cubetas : cantidadHuevosUnidades %></strong>
                            <%= esHuevo ? 'Cubeta(s)' : (item.unidad || 'Unidad(es)') %>
                            <% if (esHuevo) { %>
                                <small style="display: block; color: #666;">(<%= cantidadHuevosUnidades %> huevos en total)</small>
                            <% } %>
                        </p>

                        <p class="presentacion-producto">
                            <% if (esHuevo) { %>
                                Precio por cubeta: <strong>$<%= precioCubeta.toLocaleString("es-CO") %></strong>
                                <small style="display: block; color: #888;">($<%= precioUnitarioReal.toLocaleString("es-CO") %> / huevo)</small>
                            <% } else { %>
                                Precio un.: $<%= precioUnitarioReal.toLocaleString("es-CO") %>
                            <% } %>
                        </p>

                        <div class="precio-producto">
                            Total: $<%= totalPagar.toLocaleString("es-CO") %>
                        </div>

                        <% if (!esConfirmado && item.fecha) { 
                            const fechaApartado = new Date(item.fecha);
                            const expira = new Date(fechaApartado.getTime() + 10 * 1000);
                        %>
                            <div class="temporizador-apartado" data-expira="<%= expira.toISOString() %>">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                </svg>
                                <span class="texto-temporizador"></span>
                            </div>
                        <% } %>

                        <% if (esConfirmado) { %>
                            <button type="button" class="btn-dismiss btn-dismiss-confirmado" data-id="<%= item.id_apartado %>">
                                Eliminar
                            </button>
                        <% } else { %>
                            <button type="button" class="btn-cancelar btn-accion-cancelar" data-id="<%= item.id_apartado %>">
                                Cancelar Apartado
                            </button>
                        <% } %>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="estado-vacio">
                <h3>No tienes apartados activos</h3>
                <p>Explora nuestro catálogo y aparta tus productos favoritos.</p>
                <a href="/catalogo" class="btn-explorar">Ver Catálogo</a>
            </div>
        <% } %>
    </main>

    <script src="/js/toast.js"></script>
    <script src="/js/verApartados.js"></script>
</body>

</html>