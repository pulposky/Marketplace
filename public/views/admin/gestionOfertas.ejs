<!DOCTYPE html>
<html lang="es">

<head>
    <%- include('../partials/headMeta', { titulo: 'Gestión de Ofertas' }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <link rel="stylesheet" href="/css/admin/gestionOfertas.css">
    <link rel="stylesheet" href="/css/admin/barraFiltros.css">
    <link rel="stylesheet" href="/css/toast.css">
    <%- include('partials/estilosPanel') %>
</head>

<body>
    <%- include('partials/menuPanel') %>

    <!-- HEADER Y BARRA SUPERIOR -->
    <div class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <a href="/admin" class="marca-panel"><img src="<%= tienda.logo_url || '/img/marca/logo-default.svg' %>" alt="" class="marca-panel-logo"><b><%= tienda.nombre %></b></a>
                <span class="marca-seccion">Gestión de Ofertas</span>
            </div>
            <div>
                <a href='/admin' class="btn-regresar">
                    ← Panel
                </a>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="contenedor-principal">

        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="encabezado-seccion">
            <div class="titulo-catalogo">Configurar Descuentos y Ofertas <small class="total-listado"><%= total.toLocaleString('es-CO') %> resultado<%= total === 1 ? '' : 's' %></small></div>
        </div>

        <%# Barra de filtros (GET), la misma de Productos (barraFiltros.css). gestionOfertas.js envía al cambiar un select. %>
        <form class="barra-filtros" method="get" action="/admin/ofertas" role="search" aria-label="Filtrar productos">
            <label class="filtro-buscar">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <span class="solo-lector">Buscar</span>
                <input type="search" id="busqueda-oferta" name="q" value="<%= filtros.q %>" placeholder="Buscar productos…">
            </label>
            <label class="filtro-pildora<%= filtros.categoria ? ' activo' : '' %>">
                <span>Categoría</span>
                <select id="filtro-categoria-oferta" name="categoria" data-auto-envio>
                    <option value="">Todas</option>
                    <% categoriasFiltro.forEach((c) => { %>
                        <option value="<%= c %>" <%= filtros.categoria === c ? 'selected' : '' %>><%= c %></option>
                    <% }) %>
                </select>
            </label>
            <label class="filtro-pildora<%= filtros.oferta ? ' activo' : '' %>">
                <span>Descuento</span>
                <select id="filtro-solo-oferta" name="oferta" data-auto-envio>
                    <option value="">Todos</option>
                    <option value="1" <%= filtros.oferta ? 'selected' : '' %>>En oferta</option>
                </select>
            </label>
            <% if (filtros.q || filtros.categoria || filtros.oferta) { %>
                <a class="limpiar-filtros" href="/admin/ofertas">✕ Quitar filtros</a>
            <% } %>
        </form>

        <p class="nota-instrucciones">
            Aquí puedes <strong>cambiar el precio</strong> de un producto o <strong>ponerle un descuento</strong>
            (% de rebaja). Si pones descuento, deja las fechas vacías para que dure siempre.
        </p>

        <!-- CONTENIDO PRINCIPAL -->
        <div class="contenido-principal">

            <!-- REJILLA DE PRODUCTOS -->
            <div class="rejilla-productos" id="contenedorProductos">

                <% if (productos && productos.length> 0) { %>
                    <% productos.forEach(producto=> {
                        const nombreMostrar = producto.nombre;
                        const presentacionMostrar = producto.unidad || 'N/A';
                        // Presentaciones de venta (el precio se edita por unidad mínima)
                        const presentaciones = Array.isArray(producto.presentaciones) ? producto.presentaciones : [];

                        // Precio por unidad mínima
                        const precioCalculado = Number(producto.precio || 0);

                        // Oferta existente
                        const descuentoActual = Number(producto.descuento) || 0;
                        const hayOferta = descuentoActual > 0;

                        // Fechas en formato para input datetime-local (YYYY-MM-DDTHH:mm)
                        const fmtFecha = (fecha) => {
                            if (!fecha) return '';
                            const d = new Date(fecha);
                            if (isNaN(d.getTime())) return '';
                            const pad = (n) => String(n).padStart(2, '0');
                            return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
                        };
                        const inicioActual = fmtFecha(producto.fecha_inicio_oferta);
                        const finActual = fmtFecha(producto.fecha_fin_oferta);

                        // Precio final con descuento (para mostrar la vista previa)
                        const desc = Math.min(Math.max(descuentoActual, 0), 99.99);
                        const precioConDescuento = hayOferta ? precioCalculado * (1 - desc / 100) : precioCalculado;
                        %>
                        <div class="tarjeta-producto" data-id="<%= producto.id_producto %>"
                            data-nombre="<%= (nombreMostrar || '').toLowerCase() %>"
                            data-categoria="<%= producto.categoria || '' %>"
                            data-en-oferta="<%= hayOferta %>">

                            <!-- Imagen del Producto -->
                            <div class="imagen-producto">
                                <% if (producto.imagenUpload) { %>
                                    <img src="<%= producto.imagenUpload %>" alt="<%= nombreMostrar %>" loading="lazy">
                                <% } else { %>
                                    <span><%= nombreMostrar %></span>
                                <% } %>
                                <% if (hayOferta) { %>
                                    <span class="badge-oferta">OFERTA -<%= desc %>%</span>
                                <% } %>
                            </div>

                            <div class="presentacion-producto">
                                Presentación: <%= presentacionMostrar %>
                            </div>

                            <div class="nombre-producto">
                                <%= nombreMostrar %>
                            </div>

                            <!-- Precios -->
                            <div class="precio-producto">
                                <% if (hayOferta) { %>
                                    <span class="precio-original">$<%= precioCalculado.toLocaleString("es-CO") %></span>
                                    <br>
                                    <span class="precio-descuento">$<%= precioConDescuento.toLocaleString("es-CO") %></span>
                                <% } else { %>
                                    $<%= precioCalculado.toLocaleString("es-CO") %>
                                <% } %>
                                <% presentaciones.forEach(p => { %>
                                    <small class="precio-presentacion"><%= p.nombre %> (<%= p.factor %> und): $<%= (precioConDescuento * p.factor).toLocaleString("es-CO") %></small>
                                <% }) %>
                            </div>

                            <!-- Editar precio rápido -->
                            <div class="grupo-precio">
                                <div class="fila-campo">
                                    <label class="texto-control" for="precio-<%= producto.id_producto %>">
                                        Precio por <%= presentacionMostrar %> :
                                    </label>
                                    <input type="number" id="precio-<%= producto.id_producto %>"
                                        class="campo-precio" min="0" step="0.01"
                                        value="<%= precioCalculado %>" data-id="<%= producto.id_producto %>">
                                </div>
                            </div>

                            <!-- Formulario de oferta -->
                            <div class="panel-oferta">
                                <div class="campo-oferta">
                                    <label class="texto-control" for="desc-<%= producto.id_producto %>">
                                        Descuento (%) :
                                    </label>
                                    <input type="number" id="desc-<%= producto.id_producto %>"
                                        class="campo-descuento" min="0" max="99.99" step="0.01"
                                        value="<%= desc %>" data-id="<%= producto.id_producto %>">
                                </div>

                                <div class="fechas-oferta">
                                    <div class="campo-oferta">
                                        <label class="texto-control">Inicio</label>
                                        <input type="datetime-local" class="campo-fecha"
                                            value="<%= inicioActual %>" data-id="<%= producto.id_producto %>"
                                            data-tipo="inicio">
                                    </div>
                                    <div class="campo-oferta">
                                        <label class="texto-control">Fin</label>
                                        <input type="datetime-local" class="campo-fecha"
                                            value="<%= finActual %>" data-id="<%= producto.id_producto %>"
                                            data-tipo="fin">
                                    </div>
                                </div>

                                <div class="acciones-tarjeta">
                                    <button type="button" class="btn-guardar-oferta" data-id="<%= producto.id_producto %>">
                                        Guardar
                                    </button>
                                    <button type="button" class="btn-cancelar-oferta" data-id="<%= producto.id_producto %>">
                                        Cancelar oferta
                                    </button>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                <% } else { %>
                    <p class="sin-resultados">No hay productos con esos filtros.</p>
                <% } %>

            </div>
            <%- include('../partials/paginacion', { ruta: '/admin/ofertas', consulta, pagina, totalPaginas }) %>
        </div>
    </div>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/admin/gestionOfertas.js"></script>
</body>

</html>
