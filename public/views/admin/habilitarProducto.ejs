<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Productos - Panel Admin</title>
    <link rel="stylesheet" href="/css/admin/habilitarProducto.css">
    <link rel="stylesheet" href="/css/toast.css">
</head>

<body>

    <!-- HEADER Y BARRA SUPERIOR -->
    <div class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <span>Habilitación de Productos</span> - Panel Admin
            </div>
            <div style="display:flex; gap:10px; align-items:center;">
                <button type="button" class="btn-nuevo-producto" id="btnNuevoProducto">+ Nuevo Producto</button>
                <a href='/admin' class="btn-regresar">
                    ← Regresar al Inicio
                </a>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="contenedor-principal">

        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="encabezado-seccion">
            <div class="titulo-catalogo">Habilitar Productos para Venta</div>

            <div class="barra-superior">
                <div class="campo-busqueda">
                    <input type="text" id="busqueda-producto" placeholder="Buscar producto por nombre...">
                </div>
            </div>
        </div>

        <!-- CONTENIDO PRINCIPA-->
        <div class="contenido-principal">

            <!-- PANEL LATERAL -->
            <div class="panel-lateral">
                <div class="titulo-categoria">Filtros de Gestión</div>
                <div class="linea-divisora"></div>

                <div class="lista-filtros">
                    <div class="item-filtro">
                        <input type="checkbox" id="filtro-disponibles">
                        <label for="filtro-disponibles">Solo habilitados</label>
                    </div>
                </div>

                <div class="boton-filtrar">Aplicar Filtros</div>
            </div>

            <!-- REJILLA DE PRODUCTOS -->
            <!-- REJILLA DE PRODUCTOS -->
            <div class="rejilla-productos" id="contenedorProductos">

                <% if (productos && productos.length> 0) { %>
                    <% productos.forEach(producto=> {
                        // Evaluamos si es huevo por unidad
                        const esHuevoUnidad = producto.nombre === "HUEVOS DE GALLINA AA UND" || producto.nombre ===
                        "HUEVOS DE GALLINA A UND";

                        // Nombre y presentación dinámicos
                        const nombreMostrar = esHuevoUnidad ? producto.nombre.replace("UND", "CUBETA") :
                        producto.nombre;
                        const presentacionMostrar = esHuevoUnidad ? "CUBETA" : (producto.unidad || 'N/A');

                        // Si son huevos y la BD maneja unidades, dividimos por 30 para mostrar cubetas
                        const unidadesStock = producto.limite_venta || 0;
                        const cantidadMostrar = esHuevoUnidad ? Math.floor(unidadesStock / 30) : unidadesStock;

                        // Precio por cubeta o por unidad
                        const precioCalculado = esHuevoUnidad ? Number(producto.precio || 0) * 30 :
                        Number(producto.precio || 0);
                        %>
                        <div class="tarjeta-producto" data-id="<%= producto.id_producto %>"
                            data-nombre="<%= (nombreMostrar || '').toLowerCase() %>"
                            data-estado="<%= producto.estado %>" data-cantidad="<%= cantidadMostrar %>"
                            data-nombre-original="<%= producto.nombre %>"
                            data-unidad="<%= producto.unidad || '' %>"
                            data-categoria="<%= producto.categoria || '' %>"
                            data-lugar="<%= producto.lugar || '' %>"
                            data-precio="<%= Number(producto.precio || 0) %>"
                            data-descripcion="<%= producto.descripcion || '' %>">

                            <!-- Imagen del Producto -->
                            <div class="imagen-producto">
                                <% if (producto.imagenUpload) { %>
                                    <img src="<%= producto.imagenUpload %>" alt="<%= nombreMostrar %>">
                                    <% } else { %>
                                        <span>
                                            <%= nombreMostrar %>
                                        </span>
                                        <% } %>
                            </div>

                            <!-- Datos del Producto -->
                            <div class="presentacion-producto">
                                Presentación: <%= presentacionMostrar %>
                            </div>

                            <div class="nombre-producto">
                                <%= nombreMostrar %>
                            </div>

                            <div class="precio-producto">
                                $<%= precioCalculado.toLocaleString("es-CO") %>
                            </div>

                            <div class="linea-divisora"></div>

                            <!-- Panel de Controles -->
                            <div class="panel-controles">
                                <div class="grupo-control">
                                    <div class="texto-control">
                                        <%= esHuevoUnidad ? 'Cubetas a vender:' : 'Cantidad a vender:' %>
                                    </div>
                                    <input type="number" class="campo-cantidad" min="0" value="<%= cantidadMostrar %>"
                                        placeholder="0" data-id="<%= producto.id_producto %>"
                                        data-es-huevo="<%= esHuevoUnidad %>">
                                </div>

                                <div class="grupo-control">
                                    <div class="texto-control">Habilitar venta:</div>
                                    <label class="interruptor">
                                        <input type="checkbox" class="check-habilitar"
                                            data-id="<%= producto.id_producto %>" <%=producto.estado==='activo'
                                            ? 'checked' : '' %>>
                                        <div class="deslizador"></div>
                                    </label>
                                </div>

                                <button type="button" class="btn-editar-producto"
                                    data-id="<%= producto.id_producto %>">✎ Editar</button>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p class="sin-resultados">No se encontraron productos en la base de datos.</p>
                                <% } %>

            </div>
        </div>
    </div>

    <!-- MODAL CREAR / EDITAR PRODUCTO -->
    <div class="modal-fondo" id="modalProducto">
        <div class="modal-contenido modal-producto">
            <span class="cerrar-modal" id="cerrarModalProducto">&times;</span>
            <h2 id="tituloModalProducto">Nuevo Producto</h2>

            <form id="formProducto">
                <input type="hidden" id="campoIdProducto" name="id">

                <label class="campo-form">Nombre
                    <input type="text" id="campoNombre" name="nombre" required placeholder="Nombre del producto">
                </label>

                <label class="campo-form">Categoría
                    <input type="text" id="campoCategoria" name="categoria" list="listaCategorias" placeholder="Busca o escribe una categoría">
                </label>
                <datalist id="listaCategorias">
                    <option value="Abonos y Sustratos">
                    <option value="Frutas y Hortalizas">
                    <option value="Cereales, Granos y Forrajes">
                    <option value="Material Vegetal y Flores">
                    <option value="Embutidos y Cárnicos Procesados">
                    <option value="Bebidas y Refrescos">
                    <option value="Salsas y Conservas">
                    <option value="Lácteos y Derivados">
                    <option value="Repostería, Dulces y Licores">
                    <option value="Pecuario y Acuícola">
                </datalist>

                <div class="fila-campos">
                    <label class="campo-form">Unidad
                        <input type="text" id="campoUnidad" name="unidad" placeholder="UND">
                    </label>
                    <label class="campo-form">Lugar
                        <input type="text" id="campoLugar" name="lugar" placeholder="Bodega Principal">
                    </label>
                </div>

                <div class="fila-campos">
                    <label class="campo-form">Precio unitario ($)
                        <input type="number" id="campoPrecio" name="precio" min="0.01" step="0.01" required placeholder="0.00">
                    </label>
                    <label class="campo-form">Cantidad a vender
                        <input type="number" id="campoLimiteVenta" name="limiteVenta" min="0" step="1" placeholder="0">
                    </label>
                </div>

                <label class="campo-form">Descripción
                    <textarea id="campoDescripcion" name="descripcion" rows="3" placeholder="Breve descripción del producto"></textarea>
                </label>

                <label class="campo-form">Imagen
                    <input type="file" id="campoImagen" accept="image/jpeg,image/png,image/webp">
                </label>
                <div class="preview-imagen" id="previewImagen"></div>

                <button type="submit" class="btn-guardar-producto" id="btnGuardarProducto">Guardar producto</button>
            </form>
        </div>
    </div>

    <script src="/js/toast.js"></script>
    <script src="/js/admin/habilitarProducto.js"></script>
</body>

</html>