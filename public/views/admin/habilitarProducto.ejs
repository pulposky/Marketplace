<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestión de Productos - Panel Admin</title>
    <link rel="stylesheet" href="/css/admin/habilitarProducto.css">
    <link rel="stylesheet" href="/css/toast.css">
</head>

<body>

    <!-- HEADER Y BARRA SUPERIOR -->
    <div class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <span>Habilitación de Productos</span> - Panel Admin
            </div>
            <div>
                <a href='/admin' class="btn-regresar">
                    ← Regresar al Inicio
                </a>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="contenedor-principal">

        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="encabezado-seccion">
            <div class="titulo-catalogo">Habilitar Productos para Venta</div>

            <div class="barra-superior">
                <div class="campo-busqueda">
                    <input type="text" id="busqueda-producto" placeholder="Buscar producto por nombre...">
                </div>
            </div>
        </div>

        <!-- CONTENIDO PRINCIPA-->
        <div class="contenido-principal">

            <!-- PANEL LATERAL -->
            <div class="panel-lateral">
                <div class="titulo-categoria">Filtros de Gestión</div>
                <div class="linea-divisora"></div>

                <div class="lista-filtros">
                    <div class="item-filtro">
                        <input type="checkbox" id="filtro-disponibles">
                        <label for="filtro-disponibles">Solo habilitados</label>
                    </div>
                </div>

                <div class="boton-filtrar">Aplicar Filtros</div>
            </div>

            <!-- REJILLA DE PRODUCTOS -->
            <!-- REJILLA DE PRODUCTOS -->
            <div class="rejilla-productos" id="contenedorProductos">

                <% if (productos && productos.length> 0) { %>
                    <% productos.forEach(producto=> {
                        // Evaluamos si es huevo por unidad
                        const esHuevoUnidad = producto.nombre === "HUEVOS DE GALLINA AA UND" || producto.nombre ===
                        "HUEVOS DE GALLINA A UND";

                        // Nombre y presentación dinámicos
                        const nombreMostrar = esHuevoUnidad ? producto.nombre.replace("UND", "CUBETA") :
                        producto.nombre;
                        const presentacionMostrar = esHuevoUnidad ? "CUBETA" : (producto.unidad || 'N/A');

                        // Si son huevos y la BD maneja unidades, dividimos por 30 para mostrar cubetas
                        const unidadesStock = producto.limite_venta || 0;
                        const cantidadMostrar = esHuevoUnidad ? Math.floor(unidadesStock / 30) : unidadesStock;

                        // Precio por cubeta o por unidad
                        const precioCalculado = esHuevoUnidad ? Number(producto.precio || 0) * 30 :
                        Number(producto.precio || 0);
                        %>
                        <div class="tarjeta-producto" data-id="<%= producto.id_producto %>"
                            data-nombre="<%= (nombreMostrar || '').toLowerCase() %>"
                            data-estado="<%= producto.estado %>" data-cantidad="<%= cantidadMostrar %>">

                            <!-- Imagen del Producto -->
                            <div class="imagen-producto">
                                <% if (producto.imagenUpload) { %>
                                    <img src="<%= producto.imagenUpload %>" alt="<%= nombreMostrar %>">
                                    <% } else { %>
                                        <span>
                                            <%= nombreMostrar %>
                                        </span>
                                        <% } %>
                            </div>

                            <!-- Datos del Producto -->
                            <div class="presentacion-producto">
                                Presentación: <%= presentacionMostrar %>
                            </div>

                            <div class="nombre-producto">
                                <%= nombreMostrar %>
                            </div>

                            <div class="precio-producto">
                                $<%= precioCalculado.toLocaleString("es-CO") %>
                            </div>

                            <div class="linea-divisora"></div>

                            <!-- Panel de Controles -->
                            <div class="panel-controles">
                                <div class="grupo-control">
                                    <div class="texto-control">
                                        <%= esHuevoUnidad ? 'Cubetas a vender:' : 'Cantidad a vender:' %>
                                    </div>
                                    <input type="number" class="campo-cantidad" min="0" value="<%= cantidadMostrar %>"
                                        placeholder="0" data-id="<%= producto.id_producto %>"
                                        data-es-huevo="<%= esHuevoUnidad %>">
                                </div>

                                <div class="grupo-control">
                                    <div class="texto-control">Habilitar venta:</div>
                                    <label class="interruptor">
                                        <input type="checkbox" class="check-habilitar"
                                            data-id="<%= producto.id_producto %>" <%=producto.estado==='activo'
                                            ? 'checked' : '' %>>
                                        <div class="deslizador"></div>
                                    </label>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <p class="sin-resultados">No se encontraron productos en la base de datos.</p>
                                <% } %>

            </div>
        </div>
    </div>

    <script src="/js/toast.js"></script>
    <script src="/js/admin/habilitarProducto.js"></script>
</body>

</html>