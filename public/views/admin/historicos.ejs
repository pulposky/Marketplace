<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Históricos y Estadísticas - Panel Admin</title>
    <link rel="stylesheet" href="/css/admin/historicos.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>

    <!-- HEADER -->
    <div class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <span>Analítica</span> - Panel Admin
            </div>
            <div class="header-derecha">
                <a href="/api/admin/historicos/exportar" class="btn-exportar-excel">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Exportar Excel
                </a>
                <a href="/admin" class="btn-regresar">
                    ← Regresar al Inicio
                </a>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="contenedor-principal">

        <!-- TARJETAS RESUMEN -->
        <div class="resumen-grid">
            <div class="resumen-card resumen-ventas">
                <div class="resumen-icono">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                </div>
                <div class="resumen-info">
                    <span class="resumen-valor"><%= resumen.ventasEntregadas %></span>
                    <span class="resumen-label">Ventas Entregadas</span>
                </div>
            </div>

            <div class="resumen-card resumen-clientes">
                <div class="resumen-icono">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <div class="resumen-info">
                    <span class="resumen-valor"><%= resumen.clientesCompradores %></span>
                    <span class="resumen-label">Clientes Compradores</span>
                </div>
            </div>

            <div class="resumen-card resumen-visitas">
                <div class="resumen-icono">
                    <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                </div>
                <div class="resumen-info">
                    <span class="resumen-valor"><%= resumen.totalVisitas %></span>
                    <span class="resumen-label">Visitas (30 días)</span>
                </div>
            </div>
        </div>

        <!-- GRÁFICOS - FILA 1 -->
        <div class="graficos-fila">
            <div class="grafico-card">
                <h3>Productos Más Vendidos</h3>
                <p class="grafico-subtitulo">Top 10 por cantidad entregada</p>
                <div class="grafico-contenedor">
                    <canvas id="graficoProductos"></canvas>
                </div>
            </div>

            <div class="grafico-card">
                <h3>Clientes Que Más Compran</h3>
                <p class="grafico-subtitulo">Top 10 por pedidos entregados</p>
                <div class="grafico-contenedor">
                    <canvas id="graficoClientes"></canvas>
                </div>
            </div>
        </div>

        <!-- GRÁFICOS - FILA 2 -->
        <div class="graficos-fila">
            <div class="grafico-card">
                <h3>Ventas por Día</h3>
                <p class="grafico-subtitulo">Últimos 30 días (entregadas)</p>
                <div class="grafico-contenedor">
                    <canvas id="graficoVentasDia"></canvas>
                </div>
            </div>

            <div class="grafico-card">
                <h3>Visitas por Día</h3>
                <p class="grafico-subtitulo">Últimos 30 días</p>
                <div class="grafico-contenedor">
                    <canvas id="graficoVisitasDia"></canvas>
                </div>
            </div>
        </div>

        <!-- GRÁFICOS - FILA 3 -->
        <div class="graficos-fila">
            <div class="grafico-card grafico-card-medio">
                <h3>Estado de Pedidos</h3>
                <p class="grafico-subtitulo">Distribución actual</p>
                <div class="grafico-contenedor grafico-contenedor-circular">
                    <canvas id="graficoEstados"></canvas>
                </div>
            </div>

            <div class="grafico-card grafico-card-medio">
                <h3>Rutas Más Visitadas</h3>
                <p class="grafico-subtitulo">Top 10 rutas (30 días)</p>
                <div class="grafico-contenedor">
                    <canvas id="graficoRutas"></canvas>
                </div>
            </div>
        </div>

    </div>

    <script src="/js/csrf.js"></script>
    <script src="/js/admin/historicos.js"></script>
</body>
</html>
