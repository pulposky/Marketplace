<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('../partials/headMeta', { titulo: 'Panel' }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600..800&family=Instrument+Sans:wght@400;500;600;700&display=swap">
    <link rel="stylesheet" href="/css/admin/mainAdmin.css" />
    <link rel="stylesheet" href="/css/toast.css" />
    <style>:root{--marca:<%= /^#[0-9a-fA-F]{6}$/.test(tienda.color_primario || '') ? tienda.color_primario : '#1F7A4D' %>}</style>
</head>
<body>
    <% const puedeVer = (clave) => tienePermiso(clave); %>

    <!-- AVISO EMERGENTE DE NOTIFICACIÓN NUEVA (lo maneja mainAdmin.js) -->
    <div class="toast-notificacion" id="toastNotificacion" role="status" aria-live="polite">
        <div class="toast-contenido">
            <strong class="toast-titulo"></strong>
            <p class="toast-mensaje"></p>
        </div>
        <button type="button" class="toast-cerrar" aria-label="Cerrar">&times;</button>
    </div>

    <header class="topbar">
        <div class="topbar-inner">
            <a href="/admin" class="topbar-marca">
                <img src="<%= tienda.logo_url || '/img/marca/logo-default.svg' %>" alt="" class="topbar-logo">
                <span class="topbar-nombre"><%= tienda.nombre %></span>
                <span class="topbar-badge"><%= usuario.role %></span>
            </a>
            <div class="topbar-derecha">
                <a href="/" class="topbar-enlace" target="_blank" rel="noopener">Ver la tienda</a>
                <div class="campana-contenedor" id="campanaContenedor">
                    <button type="button" class="campana-boton" id="campanaBoton" aria-label="Notificaciones">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                        <span class="campana-badge" id="campanaBadge">0</span>
                    </button>
                    <div class="campana-dropdown" id="campanaDropdown">
                        <div class="dropdown-header">
                            <span>Notificaciones</span>
                            <button type="button" class="btn-marcar-todas" id="btnMarcarTodas">Marcar todo leído</button>
                        </div>
                        <div class="dropdown-lista" id="dropdownLista">
                            <p class="dropdown-vacio">Sin notificaciones nuevas</p>
                        </div>
                    </div>
                </div>
                <form method="POST" action="/logout" class="topbar-salir">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit">Salir</button>
                </form>
            </div>
        </div>
    </header>

    <main class="tablero">
        <div class="tablero-cabeza">
            <div>
                <p class="tablero-fecha"><%= new Date().toLocaleDateString('es-CO', { weekday: 'long', day: 'numeric', month: 'long' }) %></p>
                <h1>Hola, <%= String(usuario.nombre || usuario.usuario || 'equipo').split(' ')[0] %></h1>
            </div>
            <% if (puedeVer('analitica')) { %>
            <fieldset class="periodo" id="periodo">
                <legend class="solo-lector">Período</legend>
                <label><input type="radio" name="dias" value="7"><span>7 días</span></label>
                <label><input type="radio" name="dias" value="30" checked><span>30 días</span></label>
                <label><input type="radio" name="dias" value="90"><span>90 días</span></label>
            </fieldset>
            <% } %>
        </div>

        <%# Accesos a los módulos, arriba para llegar en un clic (según permisos) %>
        <%
            // Ícono de cada módulo: trazos SVG de 24x24
            const ICONOS = {
                productos: '<path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/>',
                pedidos: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>',
                historial: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
                ofertas: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z"/><path d="M7 7h.01"/>',
                clientes: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
                categorias: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>',
                carrusel: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',
                analitica: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
                recuperacion: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
                usuarios: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>',
                auditoria: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15h6M9 11h6"/>',
                respaldo: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>',
                configuracion: '<path d="M3 9l1-5h16l1 5M4 9v11h16V9M3 9h18"/><path d="M9 20v-7h6v7"/>',
                permisos: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
            };
            const accesos = [
                ['productos', 'productos', '/admin/habilitar-producto', 'Productos'],
                ['pedidos', 'pedidos', '/admin/pedidos', 'Pedidos'],
                ['pedidos', 'historial', '/admin/historial-pedidos', 'Historial'],
                ['ofertas', 'ofertas', '/admin/ofertas', 'Ofertas'],
                ['clientes', 'clientes', '/admin/clientes', 'Clientes'],
                ['categorias', 'categorias', '/admin/categorias', 'Categorías'],
                ['carrusel', 'carrusel', '/admin/carrusel', 'Banners'],
                ['analitica', 'analitica', '/admin/historicos', 'Analítica'],
                ['recuperacion', 'recuperacion', '/admin/recuperacion', 'Recuperar clave'],
                ['usuarios', 'usuarios', '/admin/usuarios', 'Usuarios'],
                ['auditoria', 'auditoria', '/admin/auditoria', 'Auditoría'],
                ['respaldo', 'respaldo', '/admin/respaldo', 'Respaldo'],
            ].filter(([permiso]) => puedeVer(permiso));
            if (esSuperAdmin(usuario.role)) {
                accesos.push(['', 'configuracion', '/admin/configuracion', 'Configuración'], ['', 'permisos', '/admin/permisos', 'Permisos']);
            }
        %>
        <nav class="accesos" aria-label="Módulos del panel">
            <% accesos.forEach(([, icono, href, nombre]) => { %>
                <a href="<%= href %>">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><%- ICONOS[icono] %></svg>
                    <span><%= nombre %></span>
                </a>
            <% }) %>
        </nav>

        <%# Lo que necesita acción ahora; se llena según los permisos del rol %>
        <section class="atencion" id="bloqueAtencion" aria-label="Requiere atención" hidden></section>

        <% if (puedeVer('analitica')) { %>
        <section class="kpis" id="bloqueIndicadores" aria-label="Indicadores del período">
            <% [['ventas', 'Ventas entregadas'], ['apartados', 'Apartados nuevos'], ['ticket', 'Ticket promedio'], ['cancelacion', 'Cancelados'], ['clientes', 'Clientes que compraron']].forEach(([clave, nombre]) => { %>
                <article class="kpi" data-kpi="<%= clave %>">
                    <h2><%= nombre %></h2>
                    <p class="kpi-valor">–</p>
                    <p class="kpi-cambio"></p>
                </article>
            <% }) %>
        </section>

        <div class="tablero-grid">
            <section class="tarjeta tarjeta-ancha" aria-labelledby="tVentas">
                <div class="tarjeta-cabeza">
                    <h2 id="tVentas">Ventas por día</h2>
                    <p class="tarjeta-nota">Apartados entregados, en pesos</p>
                </div>
                <div class="grafica"><canvas id="graficaVentas" aria-label="Ventas entregadas por día" role="img"></canvas></div>
                <details class="tabla-datos"><summary>Ver los datos</summary><div id="tablaVentas"></div></details>
            </section>

            <section class="tarjeta" aria-labelledby="tEstados">
                <div class="tarjeta-cabeza">
                    <h2 id="tEstados">Estado de los apartados</h2>
                    <p class="tarjeta-nota">Creados en el período</p>
                </div>
                <ul class="medidores" id="listaEstados"></ul>
            </section>

            <section class="tarjeta" aria-labelledby="tTop">
                <div class="tarjeta-cabeza">
                    <h2 id="tTop">Productos que más venden</h2>
                    <p class="tarjeta-nota">Por ventas entregadas</p>
                </div>
                <ul class="medidores" id="listaTop"></ul>
            </section>

            <section class="tarjeta" aria-labelledby="tCategorias">
                <div class="tarjeta-cabeza">
                    <h2 id="tCategorias">Ventas por <%= vocab.seccion.toLowerCase() %></h2>
                    <p class="tarjeta-nota">Categorías de producto</p>
                </div>
                <ul class="medidores" id="listaCategorias"></ul>
            </section>

            <section class="tarjeta" aria-labelledby="tHoras">
                <div class="tarjeta-cabeza">
                    <h2 id="tHoras">¿A qué hora apartan?</h2>
                    <p class="tarjeta-nota">Apartados por hora del día</p>
                </div>
                <div class="grafica grafica-baja"><canvas id="graficaHoras" aria-label="Apartados por hora del día" role="img"></canvas></div>
            </section>

            <section class="tarjeta tarjeta-ancha" aria-labelledby="tVisitas">
                <div class="tarjeta-cabeza">
                    <h2 id="tVisitas">Visitas a la tienda</h2>
                    <p class="tarjeta-nota">Visitantes distintos por día</p>
                </div>
                <div class="grafica grafica-baja"><canvas id="graficaVisitas" aria-label="Visitantes por día" role="img"></canvas></div>
            </section>
        <% } else { %>
        <div class="tablero-grid">
        <% } %>

            <% if (puedeVer('productos')) { %>
            <section class="tarjeta" aria-labelledby="tStock">
                <div class="tarjeta-cabeza">
                    <h2 id="tStock">Poco stock</h2>
                    <a class="tarjeta-enlace" href="/admin/habilitar-producto">Gestionar productos</a>
                </div>
                <ul class="lista-stock" id="listaStock"></ul>
            </section>
            <% } %>

            <% if (puedeVer('pedidos')) { %>
            <section class="tarjeta tarjeta-completa" aria-labelledby="tUltimos">
                <div class="tarjeta-cabeza">
                    <h2 id="tUltimos">Últimos apartados</h2>
                    <a class="tarjeta-enlace" href="/admin/pedidos">Ver todos los pedidos</a>
                </div>
                <div class="tabla-envoltura"><table class="tabla" id="tablaUltimos"></table></div>
            </section>
            <% } %>
        </div>

    </main>

    <footer class="admin-footer">
        <p>&copy; <%= new Date().getFullYear() %> <%= tienda.nombre %> · Panel de administración</p>
    </footer>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <% if (puedeVer('analitica')) { %><script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script><% } %>
    <script src="/js/admin/mainAdmin.js"></script>
    <script src="/js/admin/dashboardAdmin.js"></script>
</body>
</html>
