<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/admin/pedidosAdmin.css">
    <link rel="stylesheet" href="/css/toast.css">
    <title>Gestión de Pedidos - Panel Admin</title>
</head>

<body>

    <!-- HEADER Y BARRA SUPERIOR -->
    <div class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <span>Pedidos</span> - Panel Admin
            </div>
            <div>
                <a href='/admin' class="btn-regresar">
                    ← Regresar al Inicio
                </a>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="contenedor-principal">

        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="encabezado-seccion">
            <div class="titulo-catalogo">Gestión de Pedidos</div>

            <div class="barra-superior">
                <a class="boton-filtrar" id="btnRefrescar">Refrescar</a>
            </div>
        </div>

        <!-- CONTENIDO -->
        <div id="contenedor-pedidos">
            <% if (typeof apartados !== 'undefined' && apartados.length > 0) { %>
                <div class="lista-pedidos">
                    <% apartados.forEach(function(item) { %>
                        <div class="pedido-card" data-id="<%= item.id_apartado %>">
                            <div class="pedido-info">
                                <div class="pedido-campo">
                                    <span class="campo-label">Cliente</span>
                                    <span class="campo-valor"><%= item.nombre_cliente %></span>
                                </div>
                                <div class="pedido-campo">
                                    <span class="campo-label">Producto</span>
                                    <span class="campo-valor"><%= item.nombre_producto %></span>
                                </div>
                                <div class="pedido-campo">
                                    <span class="campo-label">Cantidad</span>
                                    <span class="campo-valor"><%= item.cantidad %> <%= item.unidad || 'ud' %></span>
                                </div>
                            </div>
                            <div class="pedido-acciones">
                                <button class="btn-confirmar" data-id="<%= item.id_apartado %>">Confirmar</button>
                                <button class="btn-cancelar-admin" data-id="<%= item.id_apartado %>">Cancelar</button>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } else { %>
                <div class="estado-vacio" id="estadoVacio">
                    <h3>No hay pedidos pendientes</h3>
                    <p>Cuando los clientes realicen pedidos, apareceran aqui.</p>
                </div>
            <% } %>
        </div>
    </div>

    <script src="/js/toast.js"></script>
    <script src="/js/admin/pedidosAdmin.js"></script>
</body>

</html>
