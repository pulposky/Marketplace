<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/admin/pedidosAdmin.css">
    <link rel="stylesheet" href="/css/toast.css">
    <title><%= titulo %> - Panel Admin</title>
</head>

<body>

    <!-- HEADER Y BARRA SUPERIOR -->
    <div class="header-catalogo">
        <div class="contenedor-header">
            <div class="marca-catalogo">
                <span><%= titulo %></span> - Panel Admin
            </div>
            <div class="header-accesos">
                <% if (modo === 'historial') { %>
                    <!-- Desde el historial salto a los pendientes -->
                    <a href="/admin/pedidos" class="btn-acceso-admin">Pendientes</a>
                <% } else { %>
                <% } %>
                <a href='/admin' class="btn-regresar">
                    ← Regresar al Inicio
                </a>
            </div>
        </div>
    </div>

    <!-- CONTENEDOR PRINCIPAL -->
    <div class="contenedor-principal">

        <!-- ENCABEZADO DE SECCIÓN -->
        <div class="encabezado-seccion">
            <div class="titulo-catalogo"><%= titulo %></div>

            <div class="barra-superior">
                <!-- En historial: despliega u oculta todos los clientes de una -->
                <% if (modo === 'historial') { %>
                    <a class="boton-filtrar" id="btnVerTodo">Ver Todo</a>
                <% } %>
                <a class="boton-filtrar" id="btnRefrescar">Refrescar</a>
            </div>
        </div>

        <% if (modo === 'historial') { %>
            <!-- FILTROS POR ESTADO (solo en el historial) -->
            <!-- El JS recarga la lista con ?estado= según el chip activo;
                "Historial" muestra entregados + cancelados. -->
            <div class="filtros-estado" id="filtrosEstado">
                <button class="chip-filtro activo" data-estado="historial">Historial</button>
                <button class="chip-filtro" data-estado="entregado">Entregados</button>
                <button class="chip-filtro" data-estado="cancelado">Cancelados</button>
            </div>
        <% } %>
        <% if (modo === 'pendientes') { %>
            <p class="descripcion-vista">Pedidos pendientes y confirmados que esperan entrega.</p>
        <% } %>

        <!-- CONTENIDO -->
        <div id="contenedor-pedidos"></div>
    </div>

    <script src="/js/toast.js"></script>
    <script>window.MODO_PEDIDOS = '<%= modo %>';</script>
    <script src="/js/admin/pedidosAdmin.js"></script>
</body>

</html>
