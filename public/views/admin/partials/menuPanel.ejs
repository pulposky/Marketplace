<%# Menú lateral del panel: módulos agrupados según los permisos del rol.
    En pantallas angostas se abre con el botón "Menú" (sin JavaScript: checkbox + label). %>
<%
    const _ruta = typeof rutaActual !== 'undefined' ? rutaActual : '';
    const _puede = (clave) => !clave || tienePermiso(clave);
    const _super = esSuperAdmin(usuario && usuario.role);
    // Ícono de cada módulo: trazos SVG de 24x24
    const _ICONOS = {
        inicio: '<path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>',
        productos: '<path d="M21 16V8a2 2 0 0 0-1-1.7l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.7l7 4a2 2 0 0 0 2 0l7-4a2 2 0 0 0 1-1.7z"/><path d="M3.3 7 12 12l8.7-5M12 22V12"/>',
        pedidos: '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>',
        historial: '<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',
        ofertas: '<path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z"/><path d="M7 7h.01"/>',
        clientes: '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8"/>',
        categorias: '<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>',
        carrusel: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',
        analitica: '<path d="M18 20V10M12 20V4M6 20v-6"/>',
        recuperacion: '<rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
        usuarios: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6M22 11h-6"/>',
        auditoria: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15h6M9 11h6"/>',
        respaldo: '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>',
        configuracion: '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/>',
        permisos: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
        tienda: '<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14 21 3"/>',
    };
    // [grupo, [permiso, ícono, ruta, nombre]...]; '' = sin permiso especial
    const _grupos = [
        ['', [['', 'inicio', '/admin', 'Inicio']]],
        ['Ventas', [
            ['pedidos', 'pedidos', '/admin/pedidos', 'Pedidos'],
            ['pedidos', 'historial', '/admin/historial-pedidos', 'Historial'],
            ['clientes', 'clientes', '/admin/clientes', 'Clientes'],
        ]],
        ['Catálogo', [
            ['productos', 'productos', '/admin/habilitar-producto', 'Productos'],
            ['ofertas', 'ofertas', '/admin/ofertas', 'Ofertas'],
            ['categorias', 'categorias', '/admin/categorias', 'Categorías'],
            ['carrusel', 'carrusel', '/admin/carrusel', 'Banners'],
        ]],
        ['Análisis', [
            ['analitica', 'analitica', '/admin/historicos', 'Analítica'],
            ['auditoria', 'auditoria', '/admin/auditoria', 'Auditoría'],
        ]],
        ['Tienda', [
            [_super ? '' : 'nunca', 'configuracion', '/admin/configuracion', 'Personalizar tienda'],
            ['usuarios', 'usuarios', '/admin/usuarios', 'Usuarios'],
            [_super ? '' : 'nunca', 'permisos', '/admin/permisos', 'Permisos'],
            ['recuperacion', 'recuperacion', '/admin/recuperacion', 'Recuperar clave'],
            ['respaldo', 'respaldo', '/admin/respaldo', 'Respaldo'],
        ]],
    ].map(([titulo, items]) => [titulo, items.filter(([permiso]) => permiso !== 'nunca' && _puede(permiso))])
     .filter(([, items]) => items.length);
%>
<input type="checkbox" id="menuPanelAbierto" class="menu-panel-interruptor" aria-hidden="true" tabindex="-1">
<label for="menuPanelAbierto" class="menu-panel-boton">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
    <span>Menú</span>
</label>
<label for="menuPanelAbierto" class="menu-panel-fondo" aria-hidden="true"></label>
<nav class="menu-panel" aria-label="Módulos del panel">
    <a href="/admin" class="menu-panel-marca">
        <img src="<%= tienda.logo_url || '/img/marca/logo-default.svg' %>" alt="">
        <span><b><%= tienda.nombre %></b><small>Panel de administración</small></span>
    </a>
    <% _grupos.forEach(([titulo, items]) => { %>
        <div class="menu-panel-grupo">
            <% if (titulo) { %><p><%= titulo %></p><% } %>
            <% items.forEach(([, icono, href, nombre]) => {
                const _activo = href === '/admin' ? _ruta === '/admin' : _ruta.startsWith(href); %>
                <a href="<%= href %>"<%- _activo ? ' class="activo" aria-current="page"' : '' %>>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><%- _ICONOS[icono] %></svg>
                    <span><%= nombre %></span>
                </a>
            <% }) %>
        </div>
    <% }) %>
    <div class="menu-panel-pie">
        <a href="/" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><%- _ICONOS.tienda %></svg>
            <span>Ver la tienda</span>
        </a>
        <p class="menu-panel-usuario"><%= usuario.nombre || usuario.usuario %> · <%= usuario.role %></p>
    </div>
</nav>
