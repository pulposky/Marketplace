<!DOCTYPE html>
<html lang="es">

<head>
    <!-- Catálogo: pasillos, filtros, tarjetas, modal de cantidad y carrito -->
    <%- include('partials/headMeta', { titulo: 'Catálogo' }) %>
    <script nonce="<%= cspNonce %>">
        window.addEventListener('pageshow', function(e) {
            if (e.persisted) window.location.reload();
        });
    </script>
    <%- include('partials/estilosTienda') %>
</head>

<body>
    <%- include('partials/encabezado', { buscadorId: 'inputBuscar', busqueda, conModalLogin: !usuario }) %>
    <%- include('partials/pasillos', { pasillos, activas: categoriasSeleccionadas }) %>

    <%
        const _unaCategoria = categoriasSeleccionadas.length === 1
            ? pasillos.find((p) => p.nombre === categoriasSeleccionadas[0]) : null;
        const _filtrado = categoriasSeleccionadas.length > 0 || soloOferta || busqueda;
    %>
    <main class="contenedor">
        <div class="catalogo-cabeza"<%- _unaCategoria ? ` style="--k:${_unaCategoria.color}"` : '' %>>
            <div>
                <% if (_unaCategoria && vocab.numerar) { %><p class="catalogo-pasillo"><%= vocab.seccion %> <%= _unaCategoria.numero %></p><% } %>
                <h1><%= _unaCategoria ? _unaCategoria.nombre : (busqueda ? `Resultados para “${busqueda}”` : `Todo el ${vocab.catalogo.toLowerCase()}`) %></h1>
                <p class="catalogo-total"><%= productos.length %> producto<%= productos.length === 1 ? '' : 's' %>
                    <% if (_filtrado) { %> · <a href="/catalogo">Quitar filtros</a><% } %></p>
            </div>

            <form method="get" action="/catalogo" class="catalogo-filtros">
                <% categoriasSeleccionadas.forEach((c) => { %><input type="hidden" name="categoria" value="<%= c %>"><% }) %>
                <% if (busqueda) { %><input type="hidden" name="busqueda" value="<%= busqueda %>"><% } %>
                <label class="interruptor">
                    <input type="checkbox" name="soloOferta" value="1" <%= soloOferta ? 'checked' : '' %>>
                    <span>Solo ofertas</span>
                </label>
                <label class="solo-lector" for="ordenProductos">Ordenar</label>
                <select name="orden" id="ordenProductos">
                    <option value="">Orden de la tienda</option>
                    <option value="nombre" <%= orden === 'nombre' ? 'selected' : '' %>>Nombre (A-Z)</option>
                    <option value="precio-asc" <%= orden === 'precio-asc' ? 'selected' : '' %>>Precio: menor a mayor</option>
                    <option value="precio-desc" <%= orden === 'precio-desc' ? 'selected' : '' %>>Precio: mayor a menor</option>
                </select>
                <button type="submit" class="btn btn-chico btn-suave">Aplicar</button>
            </form>
        </div>

        <section class="rejilla rejilla-productos" aria-label="Productos">
            <% productos.forEach((producto) => { %>
                <%- include('partials/tarjetaProducto', { producto, pasillos, modo: 'agregar' }) %>
            <% }) %>
        </section>
        <p class="vacio" id="avisoSinResultados" <%- productos.length ? 'style="display:none;"' : '' %>>
            No hay productos con esos filtros. <a href="/catalogo">Ver todo el <%= vocab.catalogo.toLowerCase() %></a>
        </p>
        <nav class="paginacion-productos" id="paginacionProductos" aria-label="Paginación de productos"></nav>
    </main>

    <%- include('partials/pie') %>

    <!-- MODAL: ELEGIR PRESENTACIÓN Y CANTIDAD -->
    <div class="modal-fondo" id="modalApartarProducto">
        <div class="modal-contenido modal-producto" role="dialog" aria-modal="true" aria-labelledby="apartarNombreProducto">
            <button type="button" class="cerrar-modal" id="cerrarModalProducto" aria-label="Cerrar">&times;</button>
            <img id="apartarImagenProducto" src="" alt="" class="modal-producto-foto">
            <h2 id="apartarNombreProducto">Producto</h2>
            <p class="modal-ayuda" id="apartarDescripcionProducto"></p>
            <p class="modal-producto-precio"><span id="apartarPrecioProducto">$0</span> <small id="apartarPrecioDetalle"></small></p>

            <form id="formConfirmarApartado" class="formulario">
                <input type="hidden" id="apartarProductoId" name="productoId">
                <div class="campo" id="campoPresentacionModal" style="display:none;">
                    <label for="presentacionApartar">Presentación</label>
                    <select id="presentacionApartar"></select>
                </div>
                <div class="campo">
                    <label for="cantidadApartar" id="labelCantidadModal">Cantidad</label>
                    <input type="number" id="cantidadApartar" name="cantidad" value="1" min="1" max="1" required>
                    <small id="textoDisponibles">Disponibles: <span id="cantDisponiblesModal">0</span> <span id="unidadDisponiblesModal"></span></small>
                </div>
                <button type="submit" class="btn btn-ancho" id="btnAgregarCarrito">Agregar al carrito</button>
            </form>
        </div>
    </div>

    <%- include('partials/modalesCuenta') %>

    <!-- BOTÓN FLOTANTE DEL CARRITO -->
    <div class="carrito-fijo" id="carritoAnimado" role="button" tabindex="0" aria-label="Ver tu carrito">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.4 11.2a2 2 0 0 0 2 1.6h7.9a2 2 0 0 0 2-1.5L21 8H6"/><circle cx="10" cy="20.5" r="1.2"/><circle cx="18" cy="20.5" r="1.2"/></svg>
        <span>Carrito</span>
        <span class="badge-carrito-fijo" id="badgeCarritoFijo">0</span>
    </div>

    <!-- CARRITO LATERAL -->
    <div class="carrito-fondo" id="carritoFondo"></div>
    <aside class="carrito-drawer" id="carritoDrawer" aria-hidden="true" aria-labelledby="tituloCarrito">
        <div class="carrito-cabecera">
            <h2 id="tituloCarrito">Tu carrito</h2>
            <button type="button" class="cerrar-carrito" id="cerrarCarrito" aria-label="Cerrar carrito">&times;</button>
        </div>
        <div class="carrito-vacio" id="carritoVacio">
            <p>Todavía no has agregado productos.</p>
        </div>
        <ul class="carrito-lista" id="carritoLista"></ul>
        <div class="carrito-pie">
            <div class="carrito-totales">
                <span id="carritoTotalUnidades">0 artículos</span>
                <b id="carritoTotalPrecio">$0</b>
            </div>
            <button type="button" class="btn btn-ancho" id="btnConfirmarCarrito">Confirmar apartado</button>
            <button type="button" class="btn btn-ancho btn-texto" id="btnVaciarCarrito">Vaciar carrito</button>
            <p class="carrito-nota">Pagas al recoger. Te lo guardamos <%- include('partials/duracionApartado') %>.</p>
            <a href="/verApartados" class="carrito-link">Ver mis apartados</a>
        </div>
    </aside>

    <!-- AVISO DE DURACIÓN DEL APARTADO (una vez por pestaña) -->
    <div class="alerta-fondo" id="alertaApartado">
        <div class="alerta-contenido" role="alertdialog" aria-labelledby="tituloAlertaApartado">
            <h2 id="tituloAlertaApartado">Antes de apartar</h2>
            <p>Lo que apartes te lo guardamos <strong><%- include('partials/duracionApartado') %></strong>. Si no lo recoges en ese tiempo, vuelve a quedar disponible.</p>
            <button type="button" class="btn btn-ancho" id="cerrarAlertaApartado">Entendido</button>
        </div>
    </div>

    <script src="/js/csrf.js"></script>
    <script src="/js/toast.js"></script>
    <script src="/js/login.js"></script>
    <script src="/js/registro.js"></script>
    <script src="/js/olvide.js"></script>
    <script src="/js/paginacionProductos.js"></script>
    <script src="/js/productos.js"></script>
</body>

</html>
