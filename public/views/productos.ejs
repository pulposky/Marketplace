<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Productos</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>

    <h1>Lista de Productos</h1>

    <!-- Botón con el evento onclick -->
    <button type="button" onclick="obtenerProductos()">Mostrar Productos</button>

    <br><br>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Unidad</th>
                <th>Lugar</th>
                <th>Precio</th>
                <th>Stock</th>
            </tr>
        </thead>
        <tbody id="tabla-productos">
            <!-- Aquí se insertarás los productos al dar clic -->
        </tbody>
    </table>

    <!-- Vinculamos el archivo JS -->
    <script src="/js/producto.js"></script>
</body>
</html>