<!DOCTYPE html>
<html lang="es">

<head>
    <!-- Página de catálogo con la lista completa de productos y el modal de apartado -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= csrfToken %>">
    <title>Catálogo | SENAEMPRESA</title>
    <link rel="stylesheet" href="/css/login.css">
    <link rel="stylesheet" href="/css/registro.css">
    <link rel="stylesheet" href="/css/productos.css">
    <link rel="stylesheet" href="/css/toast.css">
</head>

<body>

    <!-- BARRA DE NAVEGACIÓN SUPERIOR / REGRESAR -->
    <% const rolUsuario=usuario && usuario.role ? String(usuario.role).trim().toLowerCase() : '' ; %>
        <header class="header-catalogo">
            <div class="contenedor-header">
                <a href="<%= (rolUsuario === 'admin' || rolUsuario === 'aprendiz') ? '/admin' : '/' %>"
                    class="btn-regresar">
                    ← Regresar al Inicio
                </a>

                <div class="marca-catalogo">
                    <span>SENAEMPRESA</span>
                </div>
            </div>
        </header>

        <!-- CONTENEDOR PRINCIPAL DEL CATÁLOGO -->
        <main class="contenedor-principal">

            <div class="encabezado-seccion">
                <h1 class="titulo-catalogo">CATÁLOGO DE PRODUCTOS</h1>

                <div class="barra-superior">
                    <div class="campo-busqueda">
                        <input type="text" id="inputBuscar" placeholder="Buscar producto...">
                    </div>
                </div>
            </div>

            <div class="contenido-principal">

                <!-- PANEL LATERAL DE FILTROS -->
                <aside class="panel-lateral">
                    <div class="seccion-categorias">
                        <div class="titulo-categoria">Categorías</div>
                        <div class="linea-divisora"></div>

                        <% const categoriasActivas=Array.isArray(categoriasSeleccionadas) ? categoriasSeleccionadas :
                            []; %>
                            <form method="get" action="/catalogo" class="filtros-categorias-form">
                                <div class="lista-categorias">
                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Abonos y Sustratos" <% if
                                            (categoriasActivas.includes('Abonos y Sustratos')) { %>checked<% } %>>
                                            <span>Abonos y Sustratos</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Frutas y Hortalizas" <% if
                                            (categoriasActivas.includes('Frutas y Hortalizas')) { %>checked<% } %>>
                                            <span>Frutas y Hortalizas</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Cereales, Granos y Forrajes" <%
                                            if (categoriasActivas.includes('Cereales, Granos y Forrajes')) { %>checked<%
                                            } %>>
                                            <span>Cereales, Granos y Forrajes</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Material Vegetal y Flores" <% if
                                            (categoriasActivas.includes('Material Vegetal y Flores')) { %>checked<% } %>
                                            >
                                            <span>Material Vegetal y Flores</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Embutidos y Cárnicos Procesados"
                                            <% if (categoriasActivas.includes('Embutidos y Cárnicos Procesados')) {
                                            %>checked<% } %>>
                                            <span>Embutidos y Cárnicos</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Bebidas y Refrescos" <% if
                                            (categoriasActivas.includes('Bebidas y Refrescos')) { %>checked<% } %>>
                                            <span>Bebidas y Refrescos</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Salsas y Conservas" <% if
                                            (categoriasActivas.includes('Salsas y Conservas')) { %>checked<% } %>>
                                            <span>Salsas y Conservas</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Lácteos y Derivados" <% if
                                            (categoriasActivas.includes('Lácteos y Derivados')) { %>checked<% } %>>
                                            <span>Lácteos y Derivados</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Repostería, Dulces y Licores" <%
                                            if (categoriasActivas.includes('Repostería, Dulces y Licores')) { %>checked
                                        <% } %>>
                                            <span>Repostería, Dulces y Licores</span>
                                    </label>

                                    <label class="opcion-categoria">
                                        <input type="checkbox" name="categoria" value="Pecuario y Acuícola" <% if
                                            (categoriasActivas.includes('Pecuario y Acuícola')) { %>checked<% } %>>
                                            <span>Pecuario y Acuícola</span>
                                    </label>
                                </div>

                                <button type="submit" class="boton-filtrar">Aplicar Filtros</button>
                            </form>
                    </div>

                    <!-- FILTROS ADICIONALES -->
                    <div class="seccion-categorias">
                        <form method="get" action="/catalogo" class="filtros-categorias-form">
                            <% categoriasSeleccionadas.forEach(c => { %>
                                <input type="hidden" name="categoria" value="<%= c %>">
                                <% }) %>
                                <label class="opcion-categoria">
                                    <input type="checkbox" name="soloOferta" value="1" <%= soloOferta ? 'checked' : ''
                                        %>>
                                        <span>Solo en oferta</span>
                                </label>
                                <div class="opcion-orden">
                                    <label for="ordenProductos">Ordenar por:</label>
                                    <select name="orden" id="ordenProductos">
                                        <option value="">Predeterminado</option>
                                        <option value="nombre" <%= orden === 'nombre' ? 'selected' : '' %>>Nombre (A-Z)</option>
                                        <option value="precio-asc" <%= orden === 'precio-asc' ? 'selected' : '' %>>Precio: menor a mayor</option>
                                        <option value="precio-desc" <%= orden === 'precio-desc' ? 'selected' : '' %>>Precio: mayor a menor</option>
                                    </select>
                                </div>
                                <button type="submit" class="boton-filtrar">Aplicar</button>
                        </form>
                    </div>
                </aside>

                <!-- REJILLA DE PRODUCTOS -->
                <section class="rejilla-productos">
                        <% productos.forEach(producto=> {
                        const esHuevo = producto.es_huevo || (producto.nombre &&
                        producto.nombre.toLowerCase().includes('huevo'));
                        const precioUnitarioReal = Number(producto.precio);

                        // Oferta: descuento porcentual vigente por fechas
                        const descuentoProd = Number(producto.descuento) || 0;
                        const ahoraOferta = new Date();
                        const enOferta = descuentoProd > 0
                            && (!producto.fecha_inicio_oferta || ahoraOferta >= new Date(producto.fecha_inicio_oferta))
                            && (!producto.fecha_fin_oferta || ahoraOferta <= new Date(producto.fecha_fin_oferta));
                        const precioUnitarioOferta = enOferta
                            ? precioUnitarioReal * (1 - descuentoProd / 100)
                            : precioUnitarioReal;

                        const precioMostrar = esHuevo ? precioUnitarioOferta * 30 : precioUnitarioOferta;
                        const precioOriginalMostrar = esHuevo ? precioUnitarioReal * 30 : precioUnitarioReal;
                        const textoUnidad = esHuevo ? 'Cubeta(s)' : (producto.unidad || 'Unidad(es)');

                        // CORRECCIÓN AQUÍ: Usamos Math.floor para obtener cubetas enteras y sin decimales
                        const limiteStock = producto.limite_venta || 0;
                        const cubetasDisponibles = esHuevo ? Math.floor(limiteStock / 30) : limiteStock;
                        %>
                        <div class="tarjeta-producto" data-categoria="<%= producto.categoria || '' %>">
                            <a class="enlace-detalle-producto" href="/producto/<%= producto.id_producto %>"
                                title="Ver detalles de <%= producto.nombre %>">
                                <div class="imagen-producto">
                                    <% if (producto.imagenUpload) { %>
                                        <img src="<%= producto.imagenUpload %>" alt="Imagen de <%= producto.nombre %>">
                                        <% } else { %>
                                            <span class="imagen-placeholder">
                                                <%= producto.nombre %>
                                            </span>
                                            <% } %>
                                </div>
                            </a>
                            <div class="info-producto-detalles">
                                <a class="enlace-detalle-producto" href="/producto/<%= producto.id_producto %>"
                                    title="Ver detalles de <%= producto.nombre %>">
                                    <h3 class="nombre-producto">
                                        <%= producto.nombre %>
                                    </h3>
                                </a>
                                <span class="presentacion-producto">
                                    Presentación: <%= textoUnidad %>
                                </span>

                                <% if (producto.descripcion) { %>
                                    <p class="descripcion-tarjeta">
                                        <%= producto.descripcion %>
                                    </p>
                                <% } %>

                                <p class="stock-producto">
                                    <span class="chip-stock">
                                        Disponibles: <strong>
                                            <%= cubetasDisponibles %>
                                        </strong>
                                        <%= textoUnidad %>
                                    </span>
                                    <% if (esHuevo) { %>
                                        <span class="stock-detalle">
                                            (<%= limiteStock %> huevos en total)
                                        </span>
                                        <% } %>
                                </p>

                                <div class="precio-producto">
                                    <% if (enOferta) { %>
                                        <span class="precio-original">
                                            $<%= Number(precioOriginalMostrar).toLocaleString("es-CO") %>
                                        </span>
                                        <span class="precio-oferta">
                                            $<%= Number(precioMostrar).toLocaleString("es-CO") %>
                                        </span>
                                        <span class="badge-oferta">
                                            -<%= descuentoProd %>%
                                        </span>
                                    <% } else { %>
                                        $<%= Number(precioMostrar).toLocaleString("es-CO") %>
                                    <% } %>
                                    <% if (esHuevo) { %>
                                        <span class="precio-unidad">
                                            ($<%= Number(precioUnitarioOferta).toLocaleString("es-CO") %> / huevo)
                                        </span>
                                        <% } %>
                                </div>
                            </div>

                            <button class="boton-apartar btn-accion-apartar" data-id="<%= producto.id_producto %>"
                                data-nombre="<%= producto.nombre %>"
                                data-precio="$<%= Number(precioMostrar).toLocaleString('es-CO') %>"
                                data-precio-num="<%= Number(precioMostrar).toFixed(2) %>"
                                data-precio-unitario="<%= precioUnitarioOferta %>"
                                data-es-huevo="<%= esHuevo ? 'true' : 'false' %>" data-unidad="<%= textoUnidad %>"
                                data-imagen="<%= producto.imagenUpload || '' %>"
                                data-descripcion="<%= producto.descripcion || '' %>"
                                data-limite="<%= cubetasDisponibles %>"> <!-- Pasa las cubetas enteras al JS -->
                                Agregar
                            </button>
                        </div>
                        <% }) %>
                </section>

            </div>
        </main>

        <!-- MODAL AGREGAR PRODUCTO -->
        <div class="modal-fondo" id="modalApartarProducto">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModalProducto">&times;</span>

                <main class="card-container">
                    <div class="card-body">
                        <div class="modal-imagen" style="margin-bottom:12px;">
                            <img id="apartarImagenProducto" src="" alt="Imagen del producto"
                                style="width:100%; height:auto; display:block; object-fit:contain; border-radius:8px;" />
                        </div>
                        <h1 class="product-title" id="apartarNombreProducto">Nombre del Producto</h1>

                        <p class="descripcion-modal" id="apartarDescripcionProducto"></p>

                        <div class="product-info">
                            <span class="price-tag" id="apartarPrecioProducto">$0 COP</span>
                            <small id="apartarPrecioDetalle"
                                style="display:block; color:#666; font-size:0.85rem; margin-top:2px;"></small>
                        </div>

                        <form id="formConfirmarApartado" style="width: 100%; margin-top: 15px;">
                            <input type="hidden" id="apartarProductoId" name="productoId">

                            <div class="campo" style="margin-bottom: 12px;">
                                <label for="cantidadApartar" id="labelCantidadModal"
                                    style="display:block; margin-bottom:5px;">Cantidad:</label>

                                <input type="number" id="cantidadApartar" name="cantidad" value="1" min="1" max="1"
                                    required style="width: 100%; padding: 8px;">
                                <small id="textoDisponibles" style="display:block; color:#666; margin-top:4px;">
                                    Disponibles: <span id="cantDisponiblesModal">0</span> <span
                                        id="unidadDisponiblesModal"></span>
                                </small>
                            </div>
                            <button type="submit" class="btn-principal" style="width: 100%;"
                                id="btnAgregarCarrito">Agregar al carrito</button>
                        </form>
                    </div>
                </main>
            </div>
        </div>

        <!-- MODAL LOGIN -->
        <div class="modal-fondo" id="modalLogin">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModal">&times;</span>
                <div class="contenedor-login">
                    <div class="marca">
                        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
                        <span class="marca-texto">Marketplace</span>
                    </div>
                    <main class="login" role="main">
                        <div class="login-encabezado">
                            <h1>Bienvenido</h1>
                            <p>Ingresa tus credenciales para continuar</p>
                        </div>
                        <form class="login-form" id="formLogin">
                            <div class="campo campo-tipo" style="margin-bottom:8px;">
                                <div class="tipo-options">
                                    <label class="tipo-option">
                                        <input type="radio" id="tipo_cliente" name="tipoLogin" value="cliente" checked>
                                        <span class="tipo-label">Soy Cliente</span>
                                    </label>
                                    <label class="tipo-option">
                                        <input type="radio" id="tipo_usuario" name="tipoLogin" value="usuario">
                                        <span class="tipo-label">Soy Admin</span>
                                    </label>
                                </div>
                            </div>

                            <div id="clienteFields">
                                <div class="campo" id="campoDoc">
                                    <label for="doc">Documento</label>
                                    <input type="text" id="doc" name="documento" placeholder="Documento">
                                </div>
                                <div class="campo" id="campoPwd" style="display:none;">
                                    <label for="pwdCliente">Contraseña</label>
                                    <input type="password" id="pwdCliente" name="password" placeholder="Contraseña">
                                </div>
                                <div class="campo" id="campoNuevaPwd" style="display:none;">
                                    <label for="nuevaPwd">Nueva contraseña</label>
                                    <input type="password" id="nuevaPwd" name="nuevaPassword" placeholder="Crea tu contraseña">
                                </div>
                                <div class="campo" id="campoConfirmPwd" style="display:none;">
                                    <label for="confirmPwd">Confirmar contraseña</label>
                                    <input type="password" id="confirmPwd" placeholder="Repite tu contraseña">
                                </div>
                            </div>

                            <div id="usuarioFields" style="display:none;">
                                <div class="campo">
                                    <label for="user">Usuario</label>
                                    <input type="text" id="user" name="usuario" placeholder="Usuario">
                                </div>
                                <div class="campo">
                                    <label for="pwd">Contraseña</label>
                                    <input type="password" id="pwd" name="password" placeholder="Contraseña">
                                </div>
                            </div>

                            <button type="submit" id="btnLoginSubmit" class="btn-principal">Iniciar sesión</button>
                        </form>
                        <p class="login-pie">
                            ¿No tienes cuenta? <a href="#" class="enlace-fuerte enlace-registro">Regístrate</a>
                        </p>
                        <p class="login-pie" id="enlaceOlvideLogin" style="display:none;">
                            ¿Olvidaste tu contraseña? <a href="#" class="enlace-fuerte enlace-olvide">Recupérala</a>
                        </p>
                        <p id="mensaje" class="mensaje-error"></p>
                    </main>
                    <footer class="pie-pagina">
                        <span class="pie-punto" aria-hidden="true"></span>
                        SENA · Colombia
                    </footer>
                </div>
            </div>
        </div>

        <!-- MODAL REGISTRO -->
        <div class="modal-fondo" id="modalRegistro">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModalRegistro">&times;</span>
                <div class="contenedor-registro">
                    <div class="marca">
                        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
                        <span class="marca-texto">Marketplace</span>
                    </div>
                    <main class="registro" role="main">
                        <div class="registro-encabezado">
                            <h1>Crear Cuenta</h1>
                            <p>Completa tus datos para registrarte</p>
                        </div>
                        <form class="registro-form" id="formRegistro">
                            <div class="campo">
                                <label for="regNombre">Nombre completo</label>
                                <input type="text" id="regNombre" name="nombre" placeholder="Nombre completo">
                            </div>
                            <div class="campo">
                                <label for="regDocumento">Documento</label>
                                <input type="text" id="regDocumento" name="documento" placeholder="Número de documento">
                            </div>
                            <div class="campo">
                                <label for="regDireccion">Dirección</label>
                                <input type="text" id="regDireccion" name="direccion" placeholder="Dirección">
                            </div>
                            <div class="campo">
                                <label for="regTelefono">Teléfono</label>
                                <input type="text" id="regTelefono" name="telefono" placeholder="Teléfono">
                            </div>
                            <div class="campo">
                                <label for="regRol">Rol</label>
                                <select id="regRol" name="rol">
                                    <option value="" disabled selected>Selecciona un rol</option>
                                    <option value="aprendiz">Aprendiz</option>
                                    <option value="instructor">Instructor</option>
                                    <option value="contratista">Contratista</option>
                                    <option value="externo">Externo</option>
                                    <option value="administrativo">Administrativo</option>
                                </select>
                            </div>
                            <div class="campo">
                                <label for="regPassword">Contraseña</label>
                                <input type="password" id="regPassword" name="password" placeholder="Crea tu contraseña">
                            </div>
                            <div class="campo">
                                <label for="regConfirmarPassword">Confirmar contraseña</label>
                                <input type="password" id="regConfirmarPassword" placeholder="Repite tu contraseña">
                            </div>
                            <button type="submit" class="btn-principal">Registrarme</button>
                        </form>
                        <p class="registro-pie">
                            ¿Ya tienes cuenta? <a href="#" class="enlace-fuerte" id="volverLogin">Inicia sesión</a>
                        </p>
                        <p id="mensajeRegistro" class="mensaje-registro"></p>
                    </main>
                    <footer class="pie-pagina">
                        <span class="pie-punto" aria-hidden="true"></span>
                        SENA · Colombia
                    </footer>
                </div>
            </div>
        </div>

        <!-- MODAL OLVIDÉ CONTRASEÑA -->
        <div class="modal-fondo" id="modalOlvide">
            <div class="modal-contenido">
                <span class="cerrar-modal" id="cerrarModalOlvide">&times;</span>
                <div class="contenedor-registro">
                    <div class="marca">
                        <img src="/img/Logo_sena.png" alt="Logo" class="marca-icono">
                        <span class="marca-texto">Marketplace</span>
                    </div>
                    <main class="registro" role="main">
                        <div class="registro-encabezado">
                            <h1>Olvidé mi contraseña</h1>
                            <p>Completa tu documento y crea una nueva contraseña</p>
                        </div>
                        <form class="registro-form" id="formOlvide">
                            <div class="campo">
                                <label for="olvDocumento">Documento</label>
                                <input type="text" id="olvDocumento" name="documento" placeholder="Número de documento">
                            </div>
                            <div class="campo">
                                <label for="olvNuevaPassword">Nueva contraseña</label>
                                <input type="password" id="olvNuevaPassword" name="nuevaPassword" placeholder="Nueva contraseña">
                            </div>
                            <div class="campo">
                                <label for="olvConfirmarPassword">Confirmar contraseña</label>
                                <input type="password" id="olvConfirmarPassword" placeholder="Repite tu contraseña">
                            </div>
                            <button type="submit" class="btn-principal">Restablecer contraseña</button>
                        </form>
                        <p class="registro-pie">
                            ¿Ya la recordaste? <a href="#" class="enlace-fuerte" id="volverLoginOlvide">Inicia sesión</a>
                        </p>
                        <p id="mensajeOlvide" class="mensaje-registro"></p>
                    </main>
                    <footer class="pie-pagina">
                        <span class="pie-punto" aria-hidden="true"></span>
                        SENA · Colombia
                    </footer>
                </div>
            </div>
        </div>

        <!-- CARRITO FLOTANTE (abre el carrito y muestra el contador) -->
        <div class="carrito-fijo" id="carritoAnimado" role="button" tabindex="0"
            title="Ver tu carrito" aria-label="Ver tu carrito">
            <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
            </svg>
            <span class="badge-carrito-fijo" id="badgeCarritoFijo">0</span>
        </div>

        <!-- DIBUJO CARRITO LATERAL (CARRITO REAL) -->
        <div class="carrito-fondo" id="carritoFondo"></div>
        <aside class="carrito-drawer" id="carritoDrawer" aria-hidden="true">
            <div class="carrito-cabecera">
                <h2>Tu carrito</h2>
                <button type="button" class="cerrar-carrito" id="cerrarCarrito" aria-label="Cerrar carrito">&times;</button>
            </div>

            <div class="carrito-vacio" id="carritoVacio">
                <p>Tu carrito está vacío. Agrega productos del catálogo.</p>
            </div>

            <ul class="carrito-lista" id="carritoLista"></ul>

            <div class="carrito-pie">
                <div class="carrito-totales">
                    <span class="carrito-total-unidades" id="carritoTotalUnidades">0 unidades</span>
                    <span class="carrito-total-precio" id="carritoTotalPrecio">$0</span>
                </div>
                <button type="button" class="btn-confirmar-carrito" id="btnConfirmarCarrito">Confirmar apartado</button>
                <button type="button" class="btn-vaciar-carrito" id="btnVaciarCarrito">Vaciar carrito</button>
                <p class="carrito-nota">El pago es presencial en el punto de venta. Tus productos quedan apartados por 1 hora.</p>
                <a href="/verApartados" class="carrito-link">Ver mis apartados</a>
            </div>
        </aside>

        <!-- ALERTA INFORMATIVA DE APARTADO -->
        <div class="alerta-fondo" id="alertaApartado">
            <div class="alerta-contenido">
                <div class="alerta-icono">
                    <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="16" x2="12" y2="12"/>
                        <line x1="12" y1="8" x2="12.01" y2="8"/>
