    <!DOCTYPE html>
    <html lang="es">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apartar Producto | SENAEMPRESA</title>
    <link rel="stylesheet" href="/css/apartarProductos.css">

    </head>
    <body>

    <!-- Vista Principal del Producto -->
    <main class="card-container">
    <div class="product-image-placeholder">
        <span>Imagen del Producto</span>
    </div>

    <div class="card-body">
        <span class="product-category">Categoría / Marketplace</span>
        <h1 class="product-title">Nombre del Producto</h1>
        <p class="product-description">
        Descripción detallada del producto disponible para reserva o apartado en el sistema SENAEMPRESA.
        </p>

        <div class="product-info">
        <span class="price-tag">$25.000 COP</span>
        <span class="stock-tag">Disponible</span>
        </div>

        <!-- El botón tiene la clase .boton-apartar que captura tu JS -->
        <button class="btn-apartar-main boton-apartar">Apartar Producto</button>
    </div>
    </main>


    <!-- Modal de Autenticación (Inicialmente oculto) -->
    <div class="modal-overlay" id="modalLogin">
    <div class="modal-container">
        <button class="modal-close" id="cerrarModal">&times;</button>
        
        <!-- Si tienes el logo del SENA, reemplaza el 'src' por tu ruta local -->
        <img src="/img/logo-sena.png" alt="SENA Logo" class="modal-logo" onerror="this.style.display='none'">
        
        <h2 class="modal-title">Iniciar Sesión</h2>
        <p class="modal-description">Debes ingresar a tu cuenta para realizar un apartado.</p>
        
        <form id="formLogin">
        <div class="form-group">
            <label for="usuario">Usuario</label>
            <input type="text" id="usuario" name="usuario" placeholder="Tu usuario" required>
        </div>

        <div class="form-group">
            <label for="password">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="Tu contraseña" required>
        </div>

        <div id="mensaje" class="mensaje-error"></div>

        <button type="submit" class="btn-submit">Ingresar</button>
        </form>
    </div>
    </div>

    </body>
    </html>