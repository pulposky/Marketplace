    <!DOCTYPE html>
    <html lang="es">
    <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Apartar Producto | SENAEMPRESA</title>
    <link rel="stylesheet" href="/css/apartarProductos.css">

    </head>
    <body>

    <!-- Página estática de apartado de producto -->
    <!-- Esta vista sirve como ejemplo de la tarjeta de producto y el botón de apartar -->
    <main class="card-container">
    <div class="product-image-placeholder">
        <span>Imagen del Producto</span>
    </div>

    <div class="card-body">
        <span class="product-category">Categoría / Marketplace</span>
        <h1 class="product-title">Nombre del Producto</h1>
        <p class="product-description">
        Descripción detallada del producto disponible para reserva o apartado en el sistema SENAEMPRESA.
        </p>

        <div class="product-info">
        <span class="price-tag">$25.000 COP</span>
        <span class="stock-tag">Disponible</span>
        </div>

        <!-- El botón tiene la clase .boton-apartar que captura tu JS -->
        <button class="btn-apartar-main boton-apartar">Apartar Producto</button>
    </div>
    </main>
    </body>
    </html>