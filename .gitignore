# =============================================
# MARKETPLACE - .gitignore
# =============================================

# Dependencias
node_modules/

# Variables de entorno
.env

# Build / compilación
dist/
build/

# Cobertura de tests
coverage/
.nyc_output/

# Archivos de usuario (subidas)
public/img/upload/*
!public/img/upload/.gitkeep

# Imágenes de banners promocionales (subidas)
public/img/banners/*
!public/img/banners/.gitkeep

# Logos subidos desde /admin/configuracion (el logo por defecto sí se versiona)
public/img/marca/logo-*
!public/img/marca/logo-default.svg

# Backups de base de datos
*.sql
*.sql.gz
database/backups/
# Logs
*.log
logs/
npm-debug.log*

CREDENCIALES-DEMO.txt
