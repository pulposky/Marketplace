# =============================================
# MARKETPLACE - VARIABLES DE ENTORNO
# =============================================
# Copia este archivo como .env y llena los valores.
# La app NO arranca si falta alguna obligatoria.

# Base de datos (obligatorias). Los nombres viejos BD_* aún se aceptan.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=tienda_db

# Clave de sesión (obligatoria, mínimo 32 caracteres aleatorios).
# Genérala con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Puerto HTTP (opcional, por defecto 3000)
PORT=3000

# "development" o "production" (production activa cookie secure y trust proxy)
NODE_ENV=development

# Máximo de peticiones por IP cada 15 min (opcional, por defecto 300)
RATE_LIMIT_MAX=300
